{
  "name": "premium-ecommerce-platform",
  "version": "1.0.0",
  "description": "Premium ecommerce platform.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "node scripts/prepare-mongodb-schema.mjs && prisma generate --schema=prisma/mongodb-schema && next build",
    "build:cloudflare": "node scripts/prepare-mongodb-schema.mjs && prisma generate --no-engine --schema=prisma/mongodb-schema && opennextjs-cloudflare build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\" \"app/**/__tests__/*.test.ts\"",
    "backend:audit": "node scripts/backend-audit.mjs",
    "db:push": "node scripts/prepare-mongodb-schema.mjs && prisma db push --schema=prisma/mongodb-schema",
    "db:deploy": "node scripts/prepare-mongodb-schema.mjs && prisma db push --schema=prisma/mongodb-schema",
    "db:migrate:export": "node scripts/migrate-postgres-to-mongodb.mjs export",
    "db:migrate:import": "node scripts/migrate-postgres-to-mongodb.mjs import",
    "db:migrate:validate": "node scripts/validate-mongodb-migration.mjs",
    "db:ensure-admin": "tsx scripts/ensure-admin.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/client": "^6.19.3",
    "@prisma/extension-accelerate": "^2.0.0",
    "bcryptjs": "^3.0.0",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "wrangler": "^4.129.1"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

{
  "name": "premium-ecommerce-platform",
  "version": "1.0.0",
  "description": "Premium ecommerce platform.",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "build:cloudflare": "prisma generate && opennextjs-cloudflare build && node scripts/check-worker-charset.mjs",
    "start": "next start -H 0.0.0.0 -p 3000",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\" \"app/**/__tests__/*.test.ts\"",
    "backend:audit": "node scripts/backend-audit.mjs",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:ensure-admin": "tsx scripts/ensure-admin.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.0",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.45.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "xss": "^1.0.15",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.19.3",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "^8.0.2",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

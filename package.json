{
  "name": "premium-ecommerce-platform",
  "version": "1.0.0",
  "description": "Premium ecommerce platform.",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "backend:audit": "node scripts/backend-audit.mjs",
    "db:push": "prisma db push",
    "db:deploy": "prisma db push",
    "db:migrate:export": "node scripts/migrate-postgres-to-mongodb.mjs export",
    "db:migrate:import": "node scripts/migrate-postgres-to-mongodb.mjs import",
    "db:migrate:validate": "node scripts/validate-mongodb-migration.mjs",
    "db:ensure-admin": "tsx scripts/ensure-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.0",
    "jose": "^6.0.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "15.5.24",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "8.5.26",
    "deepmerge-ts": "^8.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider   = "prisma-client-js"
  // Rust-free client: a small WebAssembly query compiler plus a driver adapter (lib/prisma.ts),
  // which is what runs on Cloudflare Workers.
  engineType = "client"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SUPPORT
  EDITOR
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIAL
  FULFILLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
  BUY_X_GET_Y
}

enum DiscountScope {
  ALL_PRODUCTS
  SPECIFIC_PRODUCTS
  SPECIFIC_COLLECTIONS
}

enum PaymentMethod {
  COD
  CARD
  BANK_TRANSFER
  WALLET
}

enum InventoryMovementType {
  RECEIPT
  SALE_RESERVATION
  SALE_RELEASE
  SALE_FULFILLMENT
  ADJUSTMENT
  RETURN
  DAMAGE
  TRANSFER
}

model User {
  id               String          @id @default(cuid())
  name             String
  email            String          @unique
  passwordHash     String
  phone            String?
  role             Role            @default(CUSTOMER)
  isActive         Boolean         @default(true)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  // Sessions issued before this moment are rejected (password/email/role change, account
  // disabled). Deliberately separate from updatedAt, which changes on every write.
  sessionsRevokedAt DateTime?
  // Custom role from Users & roles (lib/staff-roles.ts); null = the built-in role decides.
  staffRoleId      String?
  // Admin 2-step login (lib/two-step.ts): the authenticator app's secret, encrypted. It is on
  // once totpEnabledAt is set; before that the secret is a setup in progress.
  totpSecret       String?
  totpEnabledAt    DateTime?
  // The last 30-second step a code signed in with, so the same code can't be used twice.
  totpLastStep     Int?
  // Backup codes for a lost phone, as SHA-256 hashes; each one is removed once used.
  totpBackupCodes  String[]        @default([])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  cashierOrders    Order[]          @relation("OrderCashier")
  cashierShifts    CashierShift[]   @relation("ShiftCashier")
  cashMovements    CashMovement[]   @relation("CashMovementUser")
  posReturns       ReturnRequest[] @relation("ReturnCashier")
  wishlist         WishlistItem[]
  auditLogs        AuditLog[]
  orderNotes       OrderNote[]
  notifications    Notification[]
  passwordResetTokens PasswordResetToken[]
  walletTransactions WalletTransaction[]
  coinTransactions CoinTransaction[]
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  firstName   String
  lastName    String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String?
  country     String
  phone       String?
  isDefault   Boolean  @default(false)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model Collection {
  id          String               @id @default(cuid())
  name        String
  slug        String               @unique
  description String?
  imageUrl    String?
  isActive    Boolean              @default(true)
  sortOrder   Int                  @default(0)
  products    CollectionProduct[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id                 String               @id @default(cuid())
  name               String
  slug               String               @unique
  description        String?
  shortDescription   String?
  brand              String?
  vendor             String?
  productType        String?
  basePrice          Int
  compareAtPrice     Int?
  costPrice          Int?
  sku                String               @unique
  barcode            String?              @unique
  status             ProductStatus        @default(DRAFT)
  featured           Boolean              @default(false)
  seoTitle           String?
  seoDescription     String?
  seoImageUrl        String?
  weight             Float?
  weightUnit         String?
  requiresShipping   Boolean              @default(true)
  taxable            Boolean              @default(true)
  trackInventory     Boolean              @default(true)
  continueSellingWhenOutOfStock Boolean   @default(false)
  // Pre-order: keeps selling when sold out, labelled "Pre-order" with this note ("Ships in about
  // 2 weeks") on the product page, in the cart and on the order.
  preorder           Boolean              @default(false)
  preorderNote       String?
  // A short clip shown on the product page (lib/product-video.ts): the address of a file uploaded in the product editor.
  videoUrl           String?
  giftCard           Boolean              @default(false)
  salesChannelsJson  String?
  productTemplate    String?              @default("product")
  publishedAt        DateTime?
  images             ProductImage[]
  variants           ProductVariant[]
  reviews            Review[]
  wishlist           WishlistItem[]
  orderItems         OrderItem[]
  inventory          InventoryItem[]
  tags               ProductTag[]
  collections        CollectionProduct[]
  metafields         MetafieldValue[]
  backInStockRequests BackInStockRequest[]
  questions          ProductQuestion[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  @@index([status])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  name           String
  sku            String          @unique
  barcode        String?         @unique
  optionJson     String
  price          Int?
  compareAtPrice Int?
  weight         Float?
  weightUnit     String?
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      InventoryItem[]
  orderItems     OrderItem[]
}

model InventoryItem {
  id                String                   @id @default(cuid())
  productId         String
  variantId         String?
  quantity          Int                      @default(0)
  reserved          Int                      @default(0)
  lowStockThreshold  Int                      @default(5)
  locationId        String?
  product            Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant?          @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location           StoreLocation?           @relation(fields: [locationId], references: [id])
  movements          InventoryMovement[]
  @@unique([productId, variantId, locationId])
  @@index([productId, variantId])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  inventoryId    String
  type           InventoryMovementType
  quantity       Int
  reason         String?
  referenceId    String?
  createdAt      DateTime              @default(now())
  inventory      InventoryItem         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, value])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  // Empty for a review left from a delivered order's review link by a customer with no account
  // (app/review/[orderNumber]); those carry the order and the name the customer gave instead.
  userId     String?
  orderId    String?
  authorName String?
  rating     Int
  title      String?
  body       String?
  // Up to 3 photos the customer added (lib/review-photos.ts), stored in R2 like other uploads.
  photos     String[] @default([])
  approved   Boolean  @default(false)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // One review per product per order (reviews without an order are not limited by this).
  @@unique([orderId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([productId])
}

model Coupon {
  id                 String        @id @default(cuid())
  code               String        @unique
  isAutomatic        Boolean       @default(false)
  type               DiscountType
  value              Int
  minSubtotal        Int?
  maxUses            Int?
  usedCount          Int           @default(0)
  startsAt           DateTime?
  expiresAt          DateTime?
  isActive           Boolean       @default(true)
  // Which line items the discount value applies to (PERCENTAGE/FIXED) -- or,
  // for BUY_X_GET_Y, which line items count toward the "buy" requirement.
  appliesTo          DiscountScope @default(ALL_PRODUCTS)
  productIds         String[]      @default([])
  collectionIds      String[]      @default([])
  // BUY_X_GET_Y only: how many eligible units must be bought, how many
  // eligible "get" units become discounted, and by how much (100 = free).
  // getAppliesTo/getProductIds/getCollectionIds default to the buy-side
  // scope above when left unset.
  buyQuantity        Int?
  getQuantity        Int?
  getDiscountPercent Int?
  getAppliesTo       DiscountScope?
  getProductIds      String[]      @default([])
  getCollectionIds   String[]      @default([])
  firstOrderOnly     Boolean       @default(false)
  // Flash sale: an automatic discount shown on the store with its sale price and a countdown to
  // expiresAt (lib/flash-sale.ts).
  flashSale          Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model ShippingZone {
  id          String         @id @default(cuid())
  name        String
  countries   String
  regions     String?
  isActive    Boolean        @default(true)
  rates       ShippingRate[]
  createdAt   DateTime       @default(now())
}

model ShippingRate {
  id             String       @id @default(cuid())
  zoneId         String
  name           String
  price           Int
  freeAbove      Int?
  estimatedDays  Int?
  isActive       Boolean      @default(true)
  zone           ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
}

model TaxRate {
  id        String   @id @default(cuid())
  name      String
  countries String
  rate      Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Order {
  id                  String             @id @default(cuid())
  orderNumber         String             @unique
  userId              String?
  email               String
  phone               String?
  subtotal            Int
  discountTotal       Int                  @default(0)
  shippingTotal       Int                  @default(0)
  taxTotal            Int                  @default(0)
  grandTotal          Int
  currency            String               @default("USD")
  status              OrderStatus          @default(PENDING)
  paymentStatus       PaymentStatus        @default(UNPAID)
  fulfillmentStatus   FulfillmentStatus    @default(UNFULFILLED)
  paymentMethod       PaymentMethod        @default(COD)
  couponCode          String?
  shippingAddressJson String
  billingAddressJson  String?
  notes               String?
  // "This is a gift" at checkout, with the message to put in the parcel (packing slip).
  isGift              Boolean              @default(false)
  giftMessage         String?
  // The driver taking it (Admin > Orders > Drivers, lib/drivers.ts), the cash they collected on
  // delivery, and when they handed that cash to the store.
  driverId            String?
  cashCollected       Int?
  cashSettledAt       DateTime?
  trackingNumber      String?
  shippingMethod      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  events              OrderEvent[]
  reviews             Review[]
  notesHistory        OrderNote[]
  paymentTransactions PaymentTransaction[]
  paymentProofs       PaymentProof[]
  // Point of sale (prisma/models/pos.prisma). Existing online orders stay ONLINE with no till data.
  channel             OrderChannel        @default(ONLINE)
  locationId          String?
  location            StoreLocation?      @relation("OrderLocation", fields: [locationId], references: [id])
  cashierId           String?
  cashier             User?               @relation("OrderCashier", fields: [cashierId], references: [id], onDelete: SetNull)
  shiftId             String?
  shift               CashierShift?       @relation(fields: [shiftId], references: [id])
  // Set by the till for each sale; a repeated submit with the same key returns the first sale.
  idempotencyKey      String?             @unique
  // LBP per 1 USD used for this sale (null for online orders). Stored so later rate changes never alter it.
  exchangeRateLbp     Int?
  paymentLines        PaymentLine[]
  @@index([channel, createdAt])
  @@index([shiftId])
  inviteReward        InviteReward?
  driver              Driver?              @relation(fields: [driverId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([driverId])
  @@index([status])
  @@index([userId])
}

model OrderItem {
  id         String           @id @default(cuid())
  orderId    String
  productId  String
  variantId  String?
  name       String
  sku        String
  quantity   Int
  unitPrice  Int
  totalPrice Int
  // What one unit cost when it was sold (a copy, so later cost changes do not rewrite past profit).
  costPrice  Int?
  order      Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product          @relation(fields: [productId], references: [id])
  variant    ProductVariant?  @relation(fields: [variantId], references: [id])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  status      String
  message     String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderNote {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  body      String
  createdAt DateTime @default(now())
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A screenshot of a bank or wallet transfer that the customer uploaded from the order page
// (lib/payment-proof.ts). The picture sits in private storage under `key` and is only shown to
// staff on the order; it never has a public address.
model PaymentProof {
  id          String   @id @default(cuid())
  orderId     String
  key         String   @unique
  contentType String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([orderId])
}

model PaymentTransaction {
  id            String   @id @default(cuid())
  orderId       String
  provider      String
  externalId    String?
  status        String
  amount        Int
  currency      String
  rawJson       String?
  createdAt     DateTime @default(now())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  action       String
  entity       String
  entityId     String?
  metadataJson String?
  createdAt    DateTime @default(now())
  actor        User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([entity, entityId])
}

// Every email the store tries to send (lib/email.ts): sent (accepted by Resend), failed (with
// Resend's reason) or skipped (email sending not set up). Shown in Admin > Website status.
model EmailLog {
  id         String   @id @default(cuid())
  to         String
  subject    String
  status     String
  providerId String?
  error      String?
  createdAt  DateTime @default(now())
  @@index([createdAt])
}

// A browser that said yes to the store's notifications: from the visitor popup or Account >
// Notifications. Push campaigns go to all of them. userId is set when a signed-in customer
// subscribed; guests have none. (Staff order-alert devices are kept separately, in Setting.)
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}

// "Notify me when it's back" on a sold-out product (lib/back-in-stock.ts): a browser to notify
// (its push subscription) or an email address. Deleted once the customer has been told.
model BackInStockRequest {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  endpoint  String?
  p256dh    String?
  auth      String?
  email     String?
  userId    String?
  // Product, option and the browser or email: one request each, however often the button is tapped.
  dedupeKey String   @unique
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

// Money spent on ads, typed in or imported by the owner (Reports > Profit, lib/profit.ts). One
// amount per day and platform: entering or importing the same day again replaces it, so a
// re-imported file never counts twice.
model AdSpend {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  platform    String
  amount      Int
  currency    String   @default("USD")
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([date, platform])
  @@index([date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt])
}

model MediaAsset {
  id          String   @id @default(cuid())
  url         String
  name        String
  alt         String?
  mimeType    String?
  width       Int?
  height      Int?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
}

model HomepageBlock {
  id          String   @id @default(cuid())
  type        String
  title       String?
  subtitle    String?
  contentJson String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Running numbers handed out one at a time (lib/order-number.ts: "order" -> 1001, 1002, ...).
model Counter {
  name      String   @id
  value     Int
  updatedAt DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ThemeVersion {
  id         String   @id @default(cuid())
  theme      String
  sections   String
  navigation String
  createdAt  DateTime @default(now())
  createdBy  String?
  @@index([createdAt])
}

model MetafieldDefinition {
  id          String   @id @default(cuid())
  namespace   String
  key         String
  name        String
  description String?
  type        String   @default("single_line_text_field")
  ownerType   String   @default("PRODUCT")
  isList      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  values      MetafieldValue[]
  @@unique([namespace, key, ownerType])
}

model MetafieldValue {
  id          String   @id @default(cuid())
  definitionId String
  ownerType   String
  ownerId     String
  value       String
  definition  MetafieldDefinition @relation(fields:[definitionId], references:[id], onDelete:Cascade)
  product     Product  @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([definitionId, ownerId])
  @@index([ownerType, ownerId])
}

model Page {
  id            String   @id @default(cuid())
  title         String
  handle        String   @unique
  bodyHtml      String?
  template      String   @default("page")
  status        String   @default("DRAFT")
  seoTitle      String?
  seoDescription String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Blog {
  id          String   @id @default(cuid())
  title       String
  handle      String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       BlogPost[]
}

model BlogPost {
  id            String   @id @default(cuid())
  blogId        String
  title         String
  handle        String   @unique
  excerpt       String?
  bodyHtml      String?
  featuredImage String?
  authorId      String?
  status        String   @default("DRAFT")
  tagsJson      String?
  seoTitle      String?
  seoDescription String?
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  blog          Blog     @relation(fields:[blogId], references:[id], onDelete:Cascade)
  @@index([blogId, status])
}

model Theme {
  id           String   @id @default(cuid())
  name         String
  handle       String   @unique
  version      String   @default("1.0.0")
  status       String   @default("DRAFT")
  settingsJson String
  templatesJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  hits       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model WalletTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  currency    String   @default("USD")
  type        String
  reason      String?
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@index([userId, currency])
  @@unique([userId, referenceId, type])
}

model CoinTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String
  reason      String?
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
  @@unique([userId, referenceId, type])
}

// One row per visit to the store (lib/visitors.ts). A visit ends after 30 minutes without activity.
// No IP address and no GPS are kept: only the page, where the visitor came from, the approximate
// place Cloudflare reports (country and city), and the device. Cleared after 90 days.
model VisitorSession {
  id           String    @id @default(cuid())
  sid          String    @unique
  startedAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  // Set when the shopper closed the page; cleared if they come back within the visit.
  leftAt       DateTime?
  landingPath  String
  path         String
  pageViews    Int       @default(1)
  // The furthest step reached: 0 browsing, 1 product, 2 cart, 3 checkout, 4 ordered (lib/visitor-tracking.ts).
  reached      Int       @default(0)
  cartItems    Int       @default(0)
  // In cents, like order totals.
  cartValue    Int       @default(0)
  source       String    @default("direct")
  referrerHost String?
  country      String?
  city         String?
  region       String?
  // Where the visitor's network says they are, rounded to one decimal (about 10 km): a dot on the live map,
  // never a street. Not GPS.
  placeLat     Float?
  placeLng     Float?
  device       String?
  browser      String?
  os           String?
  cameBefore   Boolean   @default(false)
  userId       String?

  @@index([lastSeenAt])
  @@index([startedAt])
}

// Every store page a visitor opened (for "top pages today"). Cleared after 30 days.
model VisitorPageView {
  id   String   @id @default(cuid())
  sid  String
  path String
  at   DateTime @default(now())

  @@index([at])
  @@index([path, at])
}

// Request counters shared by every Worker instance (lib/rate-limit.ts consumeDurableRateLimit).
// The in-memory limiter alone resets per isolate, so on Cloudflare it barely slowed attackers.
model RateLimitBucket {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(0)
  resetAt DateTime

  @@index([resetAt])
}

model AdminLoginLockout {
  id          String    @id @default(cuid())
  email       String    @unique
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@index([lockedUntil])
}

model DeliveryTracking {
  id                    String   @id @default(cuid())
  orderId               String   @unique
  trackingToken         String   @unique
  latitude              Float?
  longitude             Float?
  etaMinutes            Int?
  lastLocationUpdatedAt DateTime?
  active                Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([active])
  @@index([lastLocationUpdatedAt])
}

// WhatsApp numbers collected by the welcome-discount popup (components/welcome-popup.tsx):
// shoppers who asked for the first-order code and agreed to hear about offers on WhatsApp.
model PhoneSubscriber {
  id         String   @id @default(cuid())
  phone      String   @unique
  name       String?
  source     String   @default("welcome-popup")
  createdAt  DateTime @default(now())
}

// Questions shoppers ask on a product page (lib/product-questions.ts). They stay private until the
// owner answers and publishes them in Admin > Questions; the phone, if given, is only for telling
// the shopper the answer on WhatsApp.
model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  name       String
  phone      String?
  question   String
  answer     String?
  answeredAt DateTime?
  published  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, published])
  @@index([createdAt])
}

// "Invite a friend" (lib/invites.ts): each customer's own code, one per phone number. A friend
// who orders with it gets the first-order discount set in Settings > Selling tools.
model InviteCode {
  code      String   @id
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

// The thank-you code the inviter gets once the friend's order is delivered: a one-use discount
// created in Discounts (rewardCode), one per friend's order.
model InviteReward {
  orderId    String   @id
  inviteCode String
  rewardCode String   @unique
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  @@index([inviteCode])
}

// "Rewards by phone number" (Admin > Marketing > Rewards, lib/rewards.ts): a customer who reaches
// every N delivered orders earns a thank-you code. Most customers order without an account, so the
// customer is the phone number (digits with the country code). One row per code made: `milestone`
// is which reward it is for that phone (1 = the first N orders, 2 = the next N, ...), so the same
// reward is never made twice. The code itself is a one-use discount in Discounts.
model PhoneReward {
  id        String   @id @default(cuid())
  phone     String
  milestone Int
  code      String   @unique
  name      String?
  createdAt DateTime @default(now())
  @@unique([phone, milestone])
  @@index([createdAt])
}

// "Influencer codes" (lib/influencers.ts): a person who promotes the store with their own code. The
// code is a normal discount in Discounts (same text, percent set here); every order that used it
// counts for them, and they earn commissionPercent on what was delivered. Payments made to them
// are InfluencerPayout rows; what is still owed is earned minus paid.
model Influencer {
  id                String             @id @default(cuid())
  name              String
  handle            String?
  phone             String?
  code              String             @unique
  customerPercent   Int
  commissionPercent Int
  isActive          Boolean            @default(true)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  payouts           InfluencerPayout[]
}

model InfluencerPayout {
  id           String     @id @default(cuid())
  influencerId String
  amount       Int
  note         String?
  paidAt       DateTime   @default(now())
  createdById  String?
  influencer   Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  @@index([influencerId])
}

// Admin > Customers > Win back: when a past customer was last messaged from the list, so the
// same person is not messaged again too soon.
model WinbackContact {
  phone       String   @id
  contactedAt DateTime @default(now())
}

// The people who deliver (Admin > Orders > Drivers, lib/drivers.ts). Each has a private link
// (/driver/<token>) to their own list, where they mark orders delivered and the cash collected.
// A new link replaces the old one; a driver who is turned off can't open theirs.
model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  token     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

// The store's own running costs for Reports > Profit (lib/expenses.ts): rent, salaries,
// internet... A monthly cost counts every month from startsOn until endsOn (or for good); a
// one-off counts on its day.
model Expense {
  id        String    @id @default(cuid())
  name      String
  amount    Int
  currency  String    @default("USD")
  monthly   Boolean   @default(true)
  startsOn  DateTime  @db.Date
  endsOn    DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  @@index([startsOn])
}

{%- comment -%} Thin strip above the header. Each message block rotates when there is more than one. {%- endcomment -%}
{%- if section.settings.enabled -%}
  <div class="mkAnnounce" data-announcement data-speed="{{ section.settings.speed }}" style="--mk-announce-height: {{ section.settings.height }}px">
    <div class="mkWrap mkAnnounceInner">
      {%- for block in section.blocks -%}
        <p class="mkAnnounceMsg{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }} data-announce-msg>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
      {%- if section.settings.dismissible -%}
        <button type="button" class="mkAnnounceClose" data-announce-close aria-label="{{ 'announcement.dismiss' | t }}">&times;</button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement bar", "default": true },
    { "type": "checkbox", "id": "dismissible", "label": "Visitors can close it", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per message", "min": 3, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "height", "label": "Height", "min": 30, "max": 56, "step": 2, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free delivery on orders over $50 · Cash on delivery" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": { "blocks": [ { "type": "message" } ] }
}
{% endschema %}

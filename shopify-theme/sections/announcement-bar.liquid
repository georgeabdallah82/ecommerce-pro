<div class="announcement-bar"><div class="container announcement-inner"><span>{{ section.settings.message | escape }}</span>{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} ↗</a>{% endif %}</div></div>
{% schema %}{"name":"Announcement bar","settings":[{"type":"text","id":"message","label":"Message","default":"Curated little finds. Delivered across Lebanon."},{"type":"text","id":"link_label","label":"Link label","default":"Shop now"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Announcement bar"}]}{% endschema %}

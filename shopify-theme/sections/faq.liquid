{%- comment -%} Questions that open to show their answer. Uses native details, so it works without JavaScript. {%- endcomment -%}
{%- if section.blocks.size > 0 -%}
  <section class="mkSection">
    <div class="mkWrap mkFaq">
      <h2 class="mkSectionTitle">{{ section.settings.heading | escape }}</h2>
      {%- for block in section.blocks -%}
        <details class="mkFaqItem" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="mkFaqAnswer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does cash on delivery work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Pay the driver when your order arrives.</p>" }
      ]
    }
  ],
  "presets": [ { "name": "FAQ", "blocks": [ { "type": "question" } ] } ]
}
{% endschema %}

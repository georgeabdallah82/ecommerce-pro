<footer class="site-footer"><div class="container footer-grid"><div><a class="brand footer-brand" href="{{ routes.root_url }}">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 420 | image_tag: alt: shop.name }}{% else %}<span class="wordmark">YALLA <b>HAUL<span>.</span></b></span>{% endif %}</a><p>{{ settings.tagline | escape }}</p><p class="footer-small">Curated finds for everyday life. Delivered across Lebanon.</p></div><div><h3>Explore</h3>{% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}</div><div><h3>Need help?</h3>{% if section.settings.contact_email != blank %}<a href="mailto:{{ section.settings.contact_email | escape }}">{{ section.settings.contact_email | escape }}</a>{% endif %}<a href="{{ routes.root_url }}pages/shipping">Shipping information</a><a href="{{ routes.root_url }}pages/refund-policy">Returns & refunds</a></div></div><div class="container footer-bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</span><span>{{ powered_by_link }}</span></div></footer>
{% schema %}{"name":"Footer","settings":[{"type":"link_list","id":"menu","label":"Footer menu","default":"footer"},{"type":"text","id":"contact_email","label":"Contact email"}],"presets":[{"name":"Footer"}]}{% endschema %}

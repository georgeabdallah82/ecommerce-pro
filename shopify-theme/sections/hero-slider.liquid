<section class="hero-section section-space" data-hero-slider data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
<div class="container">
{% for block in section.blocks %}
  <div class="hero-panel{% if forloop.first %} is-active{% endif %}" data-hero-slide {{ block.shopify_attributes }}>
    <div class="hero-copy"><span class="eyebrow">{{ block.settings.eyebrow | escape }}</span><h1>{{ block.settings.heading | escape }} <em>{{ block.settings.highlight | escape }}</em></h1><div class="hero-text">{{ block.settings.text }}</div><div class="hero-actions">{% if block.settings.button_label != blank %}<a class="button button-primary" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }} ↗</a>{% endif %}{% if block.settings.secondary_label != blank %}<a class="button button-secondary" href="{{ block.settings.secondary_link | default: routes.all_products_collection_url }}">{{ block.settings.secondary_label | escape }}</a>{% endif %}</div><p class="hero-note">{{ block.settings.note | escape }}</p></div>
    <div class="hero-media">{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1400 | image_tag: widths: '600,900,1200,1400', sizes: '(min-width: 900px) 50vw, 100vw', fetchpriority: 'high', alt: block.settings.image.alt | default: block.settings.heading }}{% else %}<div class="hero-placeholder"><span>YOUR NEXT LITTLE OBSESSION</span><strong>Something good<br>is coming.</strong><i>✳</i></div>{% endif %}{% if block.settings.badge != blank %}<span class="hero-badge">{{ block.settings.badge | escape }}</span>{% endif %}</div>
  </div>
{% endfor %}
{% if section.blocks.size > 1 %}<div class="hero-controls"><button type="button" data-hero-prev aria-label="Previous slide">←</button><div class="hero-dots">{% for block in section.blocks %}<button type="button" data-hero-dot class="{% if forloop.first %}is-active{% endif %}" aria-label="Show slide {{ forloop.index }}"></button>{% endfor %}</div><button type="button" data-hero-next aria-label="Next slide">→</button></div>{% endif %}
</div></section>
{% schema %}{"name":"Hero slider","max_blocks":5,"blocks":[{"type":"slide","name":"Slide","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"YOUR NEXT LITTLE OBSESSION"},{"type":"text","id":"heading","label":"Heading","default":"Good things are"},{"type":"text","id":"highlight","label":"Highlighted heading","default":"closer than you think."},{"type":"richtext","id":"text","label":"Text","default":"<p>Unexpected finds for your home, your routine, and everything in between.</p>"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"badge","label":"Image badge","default":"JUST DISCOVERED"},{"type":"text","id":"button_label","label":"Primary button","default":"Shop the finds"},{"type":"url","id":"button_link","label":"Primary link"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Explore all products"},{"type":"url","id":"secondary_link","label":"Secondary link"},{"type":"text","id":"note","label":"Supporting note","default":"Thoughtful little finds. Delivered across Lebanon."}]}],"settings":[{"type":"checkbox","id":"autoplay","label":"Autoplay","default":false},{"type":"range","id":"speed","label":"Autoplay interval in seconds","min":3,"max":10,"step":1,"default":5}],"presets":[{"name":"Hero slider","blocks":[{"type":"slide"},{"type":"slide","settings":{"eyebrow":"FRESH FINDS","heading":"Everyday, but","highlight":"never ordinary.","badge":"NEW IN","button_label":"Explore new arrivals","secondary_label":""}}]}]}{% endschema %}

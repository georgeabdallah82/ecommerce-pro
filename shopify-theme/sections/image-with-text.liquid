{%- comment -%} Photo beside a heading, text and a button. The photo side can be flipped. {%- endcomment -%}
<section class="mkSection">
  <div class="mkWrap mkImageText{% if section.settings.image_position == 'right' %} is-reversed{% endif %}">
    <div class="mkImageTextPic">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', class: 'mkImageTextImg', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200', alt: section.settings.image.alt | default: '' }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'mkImageTextImg' }}
      {%- endif -%}
    </div>
    <div class="mkImageTextBody">
      {%- if section.settings.kicker != blank -%}<p class="mkSpotKicker">{{ section.settings.kicker | escape }}</p>{%- endif -%}
      <h2 class="mkSectionTitle">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="mkBtn mkBtnPrimary" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "select", "id": "image_position", "label": "Photo side", "default": "left", "options": [
      { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }
    ] },
    { "type": "text", "id": "kicker", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made for everyday use" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}

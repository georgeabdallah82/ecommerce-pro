{%- comment -%}
  Product page: gallery, price, options, quantity, add to cart, description and shipping.
  Options and variant switching run in theme.js from the variant data below. The form also
  works without JavaScript because it posts to /cart/add.
{%- endcomment -%}
{%- liquid
  assign first_variant = product.selected_or_first_available_variant
-%}
<section class="mkWrap mkProduct" data-product data-product-id="{{ product.id }}" data-product-url="{{ product.url }}">
  <nav class="mkCrumbs" aria-label="{{ 'product.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'header.home' | t }}</a>
    {%- if product.collections.size > 0 -%}
      <span aria-hidden="true">/</span>
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    {%- endif -%}
    <span aria-hidden="true">/</span>
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="mkProductGrid">
    <div class="mkGallery" data-gallery>
      <div class="mkGalleryMain">
        {%- for media in product.media limit: 1 -%}
          {%- if media.media_type == 'image' -%}
            {{ media | image_url: width: 1200 | image_tag: loading: 'eager', class: 'mkGalleryImg', sizes: '(min-width: 900px) 50vw, 100vw', widths: '600, 900, 1200', alt: media.alt | default: product.title }}
          {%- else -%}
            {{ media | media_tag: image_size: '1200x', loading: 'eager', class: 'mkGalleryVideo' }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'mkGalleryImg' }}
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="mkThumbs" role="list">
          {%- for media in product.media limit: 8 -%}
            {%- if media.media_type == 'image' -%}
              <li>
                <button type="button" class="mkThumb{% if forloop.first %} is-active{% endif %}" data-gallery-thumb data-src="{{ media | image_url: width: 1200 }}" aria-label="{{ forloop.index }} / {{ product.media.size }}">
                  {{ media | image_url: width: 160 | image_tag: loading: 'lazy', sizes: '80px', widths: '80, 160', alt: '' }}
                </button>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="mkBuy">
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="mkBuyVendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h1 class="mkBuyTitle">{{ product.title }}</h1>

      <div class="mkBuyPrice" data-price>
        {%- render 'price', product: product, show_compare: true -%}
      </div>

      {%- if product.description != blank and section.settings.show_short_description -%}
        <p class="mkBuyLead">{{ product.description | strip_html | truncate: 180 | escape }}</p>
      {%- endif -%}

      {%- form 'product', product, id: 'mkProductForm', class: 'mkBuyForm' -%}
        {%- if product.has_only_default_variant == false -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="mkOption" data-option data-option-index="{{ forloop.index0 }}">
              <legend>{{ option.name }}: <span data-option-value>{{ option.selected_value }}</span></legend>
              <div class="mkOptionValues">
                {%- for value in option.values -%}
                  <label class="mkOptionValue{% if option.selected_value == value %} is-selected{% endif %}">
                    <input type="radio" name="option-{{ forloop.parentloop.index0 }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                    <span>{{ value | escape }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        {%- endif -%}

        <div class="mkBuyRow">
          <div class="mkQty" role="group" aria-label="{{ 'product.quantity' | t }}">
            <button type="button" class="mkQtyBtn" data-qty-minus aria-label="{{ 'product.decrease' | t }}">&minus;</button>
            <input class="mkQtyInput" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" data-qty-input aria-label="{{ 'product.quantity' | t }}">
            <button type="button" class="mkQtyBtn" data-qty-plus aria-label="{{ 'product.increase' | t }}">+</button>
          </div>
          <button type="submit" class="mkBtn mkBtnPrimary mkBtnLarge" data-add-button{% unless first_variant.available %} disabled{% endunless %}>
            {%- if first_variant.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
          </button>
        </div>

        {%- if first_variant.inventory_management == 'shopify' and first_variant.inventory_quantity > 0 and first_variant.inventory_quantity <= 5 -%}
          <p class="mkStock" data-stock>{{ 'product.only_left' | t: count: first_variant.inventory_quantity }}</p>
        {%- else -%}
          <p class="mkStock" data-stock hidden></p>
        {%- endif -%}
        <p class="mkFormMessage" role="status" data-form-message hidden></p>
      {%- endform -%}

      {%- if section.settings.shipping_text != blank -%}
        <details class="mkAccordion" open>
          <summary>{{ 'product.shipping' | t }}</summary>
          <p>{{ section.settings.shipping_text | escape }}</p>
        </details>
      {%- endif -%}

      {%- if product.description != blank and section.settings.show_description -%}
        <details class="mkAccordion" open>
          <summary>{{ 'product.details' | t }}</summary>
          <div class="rte">{{ product.description }}</div>
        </details>
      {%- endif -%}
    </div>
  </div>

  <div class="mkStickyBuy" data-sticky-buy hidden>
    <div class="mkWrap mkStickyInner">
      <span class="mkStickyTitle">{{ product.title }}</span>
      <span class="mkStickyPrice" data-sticky-price>{{ first_variant.price | money }}</span>
      <button type="button" class="mkBtn mkBtnPrimary" data-sticky-add>{{ 'product.add_to_cart' | t }}</button>
    </div>
  </div>

  {%- if section.settings.show_related -%}
    {%- assign related = product.collections.first.products -%}
    {%- if related.size > 1 -%}
      <section class="mkSection">
        <div class="mkSectionHead">
          <h2 class="mkSectionTitle">{{ 'product.related' | t }}</h2>
        </div>
        <div class="mkRail" data-rail>
          {%- for related_product in related limit: section.settings.related_limit -%}
            {%- unless related_product.id == product.id -%}
              {%- render 'product-card', product: related_product -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}

  <script type="application/json" data-variant-map>
    {
      {%- for variant in product.variants -%}
        {{ variant.id | json }}: {
          "price": {{ variant.price | money | json }},
          "compare": {{ variant.compare_at_price | money | json }},
          "available": {{ variant.available | json }},
          "options": {{ variant.options | json }},
          "stock": {% if variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= 5 %}{{ 'product.only_left' | t: count: variant.inventory_quantity | json }}{% else %}""{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
  <script type="application/json" data-recent-product>
    {
      "url": {{ product.url | json }},
      "title": {{ product.title | json }},
      "image": {{ product.featured_image | image_url: width: 300 | json }},
      "price": {{ product.price | money | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show brand", "default": true },
    { "type": "checkbox", "id": "show_short_description", "label": "Show a short lead line", "default": false },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping text", "default": "Free standard delivery is applied automatically to orders over $50. Cash on delivery." },
    { "type": "checkbox", "id": "show_related", "label": "Show related products", "default": true },
    { "type": "range", "id": "related_limit", "label": "Related products", "min": 4, "max": 12, "step": 1, "default": 8 }
  ]
}
{% endschema %}

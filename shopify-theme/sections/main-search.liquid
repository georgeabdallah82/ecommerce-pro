{%- comment -%} Search results page: products only, in the same card grid as the shop. {%- endcomment -%}
<section class="mkWrap mkSearchPage">
  <h1 class="mkPageTitle">{{ 'search.title' | t }}</h1>

  <form class="mkSearch mkSearchPageForm" action="{{ routes.search_url }}" method="get" role="search">
    <input type="hidden" name="type" value="product">
    <label class="visually-hidden" for="mkSearchPageInput">{{ 'header.search' | t }}</label>
    <input id="mkSearchPageInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'header.search_placeholder' | t }}">
    <button type="submit" class="mkSearchSubmit">{{ 'header.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    <p class="mkCount" role="status">
      {%- if search.results_count == 0 -%}
        {{ 'search.no_results' | t: terms: search.terms }}
      {%- else -%}
        {{ 'search.results_count' | t: count: search.results_count }}
      {%- endif -%}
    </p>

    {%- if search.results_count > 0 -%}
      {%- paginate search.results by section.settings.per_page -%}
        <div class="mkGrid" style="--mk-cols: {{ settings.product_columns }}">
          {%- for product in search.results -%}
            {%- render 'product-card', product: product -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="mkPagination" aria-label="{{ 'collection.pages' | t }}">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="mkEmpty">{{ 'search.try_other' | t }} <a href="{{ routes.all_products_collection_url }}">{{ 'home.view_all' | t }}</a></p>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 12, "max": 60, "step": 12, "default": 24 }
  ]
}
{% endschema %}

{%- comment -%} Shown when a page does not exist. {%- endcomment -%}
<section class="mkWrap mkNotFound">
  <h1 class="mkPageTitle">{{ 'not_found.title' | t }}</h1>
  <p>{{ 'not_found.text' | t }}</p>
  <div class="mkNotFoundActions">
    <a class="mkBtn mkBtnPrimary" href="{{ routes.root_url }}">{{ 'not_found.home' | t }}</a>
    <a class="mkBtn mkBtnOutline" href="{{ routes.all_products_collection_url }}">{{ 'home.view_all' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "Not found",
  "settings": []
}
{% endschema %}

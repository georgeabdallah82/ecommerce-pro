{%- comment -%} Heading, formatted text and an optional button. Used for policies, about text and notices. {%- endcomment -%}
<section class="mkSection">
  <div class="mkWrap mkRichText mkRichText--{{ section.settings.alignment }}">
    {%- if section.settings.heading != blank -%}
      <h2 class="mkSectionTitle">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="mkBtn mkBtnPrimary" href="{{ section.settings.button_url }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "About us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell customers who you are and how ordering works.</p>" },
    { "type": "select", "id": "alignment", "label": "Alignment", "default": "center", "options": [
      { "value": "left", "label": "Left" }, { "value": "center", "label": "Centre" }
    ] },
    { "type": "text", "id": "button_label", "label": "Button" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [ { "name": "Rich text" } ]
}
{% endschema %}

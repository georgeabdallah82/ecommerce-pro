{%- comment -%}
  Category tiles: square photos with the name under them, six across on computers and
  swipeable on phones. Add collections as blocks to choose them and their order; with no
  blocks, every collection that has products is shown.
{%- endcomment -%}
<div class="yh-section">
  <div class="yh-wrap">
    <div class="yh-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ routes.collections_url }}" class="yh-link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="yh-cats">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign c = block.settings.collection
            assign url = block.settings.link | default: c.url | default: routes.collections_url
            assign title = block.settings.title | default: c.title | default: 'Collection'
            assign c_image = block.settings.image | default: c.featured_image | default: c.products.first.featured_image
          -%}
          <a href="{{ url }}" class="yh-cat" {{ block.shopify_attributes }}>
            <span class="yh-cat__img">
              {%- if c_image -%}
                {{ c_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '200, 300, 400', sizes: '(min-width: 990px) 200px, 30vw' }}
              {%- elsif block.settings.stock != 'none' -%}
                {%- render 'yh-photo', stock: block.settings.stock -%}
              {%- else -%}
                {%- render 'yh-icon', icon: 'grid', size: 30 -%}
              {%- endif -%}
            </span>
            <span class="yh-cat__name">{{ title | escape }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections limit: 18 -%}
          {%- if c.handle == 'all' or c.handle == 'frontpage' or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign c_image = c.featured_image | default: c.products.first.featured_image -%}
          <a href="{{ c.url }}" class="yh-cat">
            <span class="yh-cat__img">
              {%- if c_image -%}
                {{ c_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: '', widths: '200, 300, 400', sizes: '(min-width: 990px) 200px, 30vw' }}
              {%- else -%}
                {%- render 'yh-icon', icon: 'grid', size: 30 -%}
              {%- endif -%}
            </span>
            <span class="yh-cat__name">{{ c.title | escape }}</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
      {%- if section.settings.deals_label != blank -%}
        <a href="{{ section.settings.deals_link | default: routes.all_products_collection_url }}" class="yh-cat yh-cat--deals">
          <span class="yh-cat__img">{%- render 'yh-icon', icon: 'fire', size: 34 -%}</span>
          <span class="yh-cat__name">{{ section.settings.deals_label | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Categories" },
    { "type": "text", "id": "link_label", "label": "\"See all\" link", "default": "See all" },
    { "type": "text", "id": "deals_label", "label": "Last tile (e.g. Deals; empty hides it)", "default": "Deals" },
    { "type": "url", "id": "deals_link", "label": "Last tile link" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Name (empty = the collection's name)" },
        { "type": "image_picker", "id": "image", "label": "Photo (empty = the collection's photo)" },
        {
          "type": "select",
          "id": "stock",
          "label": "Built-in photo (when there is no photo)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "offer-home", "label": "Living room" },
            { "value": "offer-care", "label": "Personal care" },
            { "value": "hero-rolls", "label": "Paper rolls" },
            { "value": "spot-cleaning", "label": "Cleaning" },
            { "value": "hero-bottles", "label": "Bottles" },
            { "value": "hero-kitchen", "label": "Kitchen" }
          ],
          "default": "none"
        },
        { "type": "url", "id": "link", "label": "Link (empty = the collection)" }
      ]
    }
  ],
  "presets": [{ "name": "Yalla Haul categories" }]
}
{% endschema %}

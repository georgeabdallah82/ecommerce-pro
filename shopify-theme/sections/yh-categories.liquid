{%- comment -%}
  Category circles in a white panel: round photos with the name under them, eight across on
  computers and swipeable on phones, ending with "Flash deals" and "All" icon circles.
  Add collections as blocks to choose them and their order; with no blocks, every collection
  that has products is shown.
{%- endcomment -%}
{%- capture yh_style -%}
  {%- render 'yh-var', name: '--yh-p-bg', value: section.settings.c_panel -%}
  {%- render 'yh-var', name: '--yh-p-heading', value: section.settings.c_heading -%}
  {%- render 'yh-var', name: '--yh-p-link', value: section.settings.c_link -%}
  {%- render 'yh-var', name: '--yh-k-circle', value: section.settings.c_circle -%}
  {%- render 'yh-var', name: '--yh-k-icon', value: section.settings.c_icon -%}
  {%- render 'yh-var', name: '--yh-k-text', value: section.settings.c_text -%}
{%- endcapture -%}
<div class="yh-section" style="{{ yh_style }}">
  <div class="yh-wrap">
    <div class="yh-panel">
      {%- if section.settings.heading != blank -%}
        <div class="yh-head">
          <h2>{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.link_label != blank -%}
            <a href="{{ routes.collections_url }}" class="yh-link">{{ section.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="yh-cats">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            {%- liquid
              assign c = block.settings.collection
              assign url = block.settings.link | default: c.url | default: routes.collections_url
              assign title = block.settings.title | default: c.title | default: 'Collection'
              assign c_image = block.settings.image | default: c.featured_image | default: c.products.first.featured_image
            -%}
            <a href="{{ url }}" class="yh-cat" {{ block.shopify_attributes }}>
              <span class="yh-cat__img">
                {%- if c_image -%}
                  {{ c_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', widths: '100, 150, 200', sizes: '72px' }}
                {%- elsif block.settings.stock != 'none' -%}
                  {%- render 'yh-photo', stock: block.settings.stock -%}
                {%- else -%}
                  {%- render 'yh-icon', icon: 'grid', size: 26 -%}
                {%- endif -%}
              </span>
              <span class="yh-cat__name">{{ title | escape }}</span>
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- for c in collections limit: 14 -%}
            {%- if c.handle == 'all' or c.handle == 'frontpage' or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
            {%- assign c_image = c.featured_image | default: c.products.first.featured_image -%}
            <a href="{{ c.url }}" class="yh-cat">
              <span class="yh-cat__img">
                {%- if c_image -%}
                  {{ c_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', widths: '100, 150, 200', sizes: '72px' }}
                {%- else -%}
                  {%- render 'yh-icon', icon: 'grid', size: 26 -%}
                {%- endif -%}
              </span>
              <span class="yh-cat__name">{{ c.title | escape }}</span>
            </a>
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.deals_label != blank -%}
          <a href="{{ section.settings.deals_link | default: routes.all_products_collection_url }}" class="yh-cat yh-cat--deals">
            <span class="yh-cat__img">{%- render 'yh-icon', icon: 'bolt', size: 28 -%}</span>
            <span class="yh-cat__name">{{ section.settings.deals_label | escape }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.all_label != blank -%}
          <a href="{{ routes.all_products_collection_url }}" class="yh-cat yh-cat--all">
            <span class="yh-cat__img">{%- render 'yh-icon', icon: 'grid', size: 26 -%}</span>
            <span class="yh-cat__name">{{ section.settings.all_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (empty hides it)"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "\"See all\" link next to the heading",
      "default": "See all"
    },
    {
      "type": "text",
      "id": "deals_label",
      "label": "Lightning circle (empty hides it)",
      "default": "Flash deals"
    },
    {
      "type": "url",
      "id": "deals_link",
      "label": "Lightning circle link (empty = all products)"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Last circle, all products (empty hides it)",
      "default": "All"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "c_panel",
      "label": "Panel background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "c_heading",
      "label": "Heading",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "c_link",
      "label": "\"See all\" link",
      "default": "#d42a2a"
    },
    {
      "type": "color",
      "id": "c_circle",
      "label": "Circles",
      "default": "#fff1e6"
    },
    {
      "type": "color",
      "id": "c_icon",
      "label": "Circle icons",
      "default": "#d42a2a"
    },
    {
      "type": "color",
      "id": "c_text",
      "label": "Names",
      "default": "#171717"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name (empty = the collection's name)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo (empty = the collection's photo)"
        },
        {
          "type": "select",
          "id": "stock",
          "label": "Built-in photo (when there is no photo)",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "offer-home",
              "label": "Living room"
            },
            {
              "value": "offer-care",
              "label": "Personal care"
            },
            {
              "value": "hero-rolls",
              "label": "Paper rolls"
            },
            {
              "value": "spot-cleaning",
              "label": "Cleaning"
            },
            {
              "value": "hero-bottles",
              "label": "Bottles"
            },
            {
              "value": "hero-kitchen",
              "label": "Kitchen"
            }
          ],
          "default": "none"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (empty = the collection)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yalla Haul categories"
    }
  ]
}
{% endschema %}

{%- comment -%}
  "Shop by category": round photos of collections in a swipeable row. Add collections as
  blocks to choose them and their order; with no blocks, every collection that has products
  is shown.
{%- endcomment -%}
<div class="yh-section yh-catstrip">
  <div class="yh-wrap">
    {%- if section.settings.heading != blank -%}
      <div class="yh-head"><h2>{{ section.settings.heading | escape }}</h2></div>
    {%- endif -%}
    <div class="yh-catstrip__row">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign c = block.settings.collection -%}
          <a href="{{ c.url | default: routes.collections_url }}" class="yh-catstrip__item" {{ block.shopify_attributes }}>
            <span class="yh-catstrip__icon">
              {%- assign c_image = block.settings.image | default: c.featured_image | default: c.products.first.featured_image -%}
              {%- if c_image -%}
                {{ c_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
            <span>{{ c.title | default: 'Collection' | escape }}</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for c in collections limit: 20 -%}
          {%- if c.handle == 'all' or c.handle == 'frontpage' or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
          <a href="{{ c.url }}" class="yh-catstrip__item">
            <span class="yh-catstrip__icon">
              {%- assign c_image = c.featured_image | default: c.products.first.featured_image -%}
              {%- if c_image -%}
                {{ c_image | image_url: width: 240 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
            <span>{{ c.title | escape }}</span>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul categories",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Photo (optional, otherwise the collection's photo)" }
      ]
    }
  ],
  "presets": [{ "name": "Yalla Haul categories" }]
}
{% endschema %}

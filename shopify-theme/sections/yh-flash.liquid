{%- comment -%}
  Top of the home page: a black "Flash deals" banner (photo on the right, countdown to
  midnight, button) and, next to it, a dashed coupon card and a photo tile (blocks).
  On phones the banner comes first with the photo on top, then the two cards side by side.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading | escape
  assign highlight = section.settings.highlight | escape
  if highlight != blank and heading contains highlight
    assign highlight_html = '<span>' | append: highlight | append: '</span>'
    assign heading = heading | replace_first: highlight, highlight_html
  endif
  assign has_photo = false
  if section.settings.image != blank or section.settings.stock != 'none'
    assign has_photo = true
  endif
  assign has_side = false
  if section.blocks.size > 0
    assign has_side = true
  endif
-%}
{%- capture yh_style -%}
  {%- render 'yh-var', name: '--yh-f-bg', value: section.settings.c_bg -%}
  {%- render 'yh-var', name: '--yh-f-text', value: section.settings.c_text -%}
  {%- render 'yh-var', name: '--yh-f-hl', value: section.settings.c_highlight -%}
  {%- render 'yh-var', name: '--yh-f-chip', value: section.settings.c_chip -%}
  {%- render 'yh-var', name: '--yh-f-chip-text', value: section.settings.c_chip_text -%}
  {%- render 'yh-var', name: '--yh-f-timer', value: section.settings.c_timer -%}
  {%- render 'yh-var', name: '--yh-f-timer-text', value: section.settings.c_timer_text -%}
  {%- render 'yh-var', name: '--yh-f-btn', value: section.settings.c_btn -%}
  {%- render 'yh-var', name: '--yh-f-btn-text', value: section.settings.c_btn_text -%}
{%- endcapture -%}
<div class="yh-section yh-section--top" style="{{ yh_style }}">
  <div class="yh-wrap">
    <div class="yh-top{% unless has_side %} yh-top--solo{% endunless %}">
      <div class="yh-flash{% if has_photo %} yh-flash--photo{% endif %}">
        {%- render 'yh-photo',
          image: section.settings.image,
          stock: section.settings.stock,
          class: 'yh-flash__img',
          widths: '600, 900, 1200, 1600',
          sizes: '(min-width: 990px) 560px, 100vw',
          eager: true
        -%}
        {%- if section.settings.chip != blank -%}
          <span class="yh-flash__chip">{%- render 'yh-icon', icon: 'bolt', size: 15 -%}{{ section.settings.chip | escape }}</span>
        {%- endif -%}
        <h1 class="yh-flash__title">{{ heading }}</h1>
        {%- if section.settings.text != blank -%}
          <p class="yh-flash__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.timer -%}
          <span class="yh-timer yh-timer--big" data-yh-timer role="timer" aria-label="{{ section.settings.timer_label | escape }}">
            <b data-h>00</b><b data-m>00</b><b data-s>00</b>
          </span>
        {%- endif -%}
        {%- if section.settings.button != blank -%}
          <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="yh-btn yh-btn--primary">{{ section.settings.button | escape }}</a>
        {%- endif -%}
      </div>

      {%- if has_side -%}
        <div class="yh-top__side">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'coupon' -%}
                {%- capture yh_block_style -%}{%- render 'yh-var', name: '--yh-cp-bg', value: block.settings.c_bg -%}{%- render 'yh-var', name: '--yh-cp-border', value: block.settings.c_border -%}{%- render 'yh-var', name: '--yh-cp-label', value: block.settings.c_label -%}{%- render 'yh-var', name: '--yh-cp-text', value: block.settings.c_text -%}{%- endcapture -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="yh-coupon" style="{{ yh_block_style }}" {{ block.shopify_attributes }}>
                {%- else -%}
                  <div class="yh-coupon" style="{{ yh_block_style }}" {{ block.shopify_attributes }}>
                {%- endif -%}
                  {%- if block.settings.label != blank -%}<small>{{ block.settings.label | escape }}</small>{%- endif -%}
                  <b>{{ block.settings.title | escape }}</b>
                  {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
                {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
              {%- when 'tile' -%}
                {%- capture yh_block_style -%}{%- render 'yh-var', name: '--yh-t-text', value: block.settings.c_text -%}{%- endcapture -%}
                <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="yh-mini" style="{{ yh_block_style }}" {{ block.shopify_attributes }}>
                  {%- render 'yh-photo',
                    image: block.settings.image,
                    stock: block.settings.stock,
                    class: 'yh-cover',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 990px) 400px, 50vw'
                  -%}
                  <b>{{ block.settings.title | escape }}</b>
                  {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
                </a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>


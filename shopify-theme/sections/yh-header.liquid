{%- comment -%}
  Red marketplace header: white logo, search with an orange button, Account and Cart. Sticks
  to the top. The red category tabs under it are the "Yalla Haul category tabs" section.
{%- endcomment -%}
{%- liquid
  assign logo_alt = shop.name | escape
  assign logo = section.settings.logo | default: settings.logo
-%}
<div class="yh-header" data-yh-header>
  <div class="yh-wrap yh-header__inner">
    <a href="{{ routes.root_url }}" class="yh-logo{% if section.settings.logo_white %} yh-logo--white{% endif %}" style="--yh-logo-width: {{ settings.logo_width }}px">
      {%- if logo != blank -%}
        {%- assign logo_2x = settings.logo_width | times: 2 -%}
        {{ logo | image_url: width: logo_2x | image_tag: alt: logo_alt, loading: 'eager', fetchpriority: 'high' }}
      {%- else -%}
        <img src="{{ 'yh-logo.svg' | asset_url }}" alt="{{ logo_alt }}" width="909" height="142" fetchpriority="high">
      {%- endif -%}
    </a>

    <form action="{{ routes.search_url }}" method="get" role="search" class="yh-search">
      {%- render 'yh-icon', icon: 'search', size: 18 -%}
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.search_placeholder | escape }}"
        aria-label="{{ 'general.search.search' | t }}"
      >
      <button type="submit" class="yh-search__btn">{{ section.settings.search_button | escape }}</button>
    </form>

    <div class="yh-header__actions">
      {%- if shop.customer_accounts_enabled -%}
        <shopify-account
          menu="{{ settings.customer_account_menu | default: 'customer-account-main-menu' }}"
          class="yh-hlink yh-account"
        >
          <span slot="signed-out-avatar" class="yh-hlink__inner">
            {%- render 'yh-icon', icon: 'user', size: 20 -%}
            <span class="yh-hlink__label">{{ section.settings.account_label | escape }}</span>
          </span>
        </shopify-account>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="yh-hlink yh-cartbtn" id="cart-icon-bubble">
        {%- render 'yh-icon', icon: 'cart', size: 20 -%}
        <span class="yh-hlink__label">{{ 'templates.cart.cart' | t }}</span>
        <span class="yh-cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" aria-hidden="true">{{ cart.item_count | at_most: 99 }}</span>
        <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
      </a>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>
{%- if request.page_type == 'index' -%}
  {%- assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Yalla Haul header",
  "class": "yh-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo on the red header",
      "info": "Empty = the logo from Theme settings > Logo, or the built-in Yalla Haul logo. Width: Theme settings > Logo."
    },
    {
      "type": "checkbox",
      "id": "logo_white",
      "label": "Show the logo in white",
      "info": "Turns any logo white so it reads on red. Turn off for a logo made for red backgrounds.",
      "default": true
    },
    { "type": "text", "id": "search_placeholder", "label": "Search box text", "default": "What are you looking for?" },
    { "type": "text", "id": "search_button", "label": "Search button", "default": "Search" },
    { "type": "text", "id": "account_label", "label": "Account link", "default": "Account" }
  ]
}
{% endschema %}

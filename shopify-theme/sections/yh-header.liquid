{%- comment -%}
  Bento header: a white rounded bar (logo, search, account, cart) and, on computers, a rounded
  nav bar under it. The nav links are the chosen Shopify menu (Online Store > Navigation, the
  Main menu by default); menu items with sub-items open a dropdown. On phones the nav bar is
  replaced by a menu button that opens a side panel with the same links (also opened by the
  "Menu" tab of the phone bottom bar). With an empty menu, the collections are listed.
{%- endcomment -%}
{%- liquid
  assign logo_alt = shop.name | escape
  assign logo = section.settings.logo | default: settings.logo
  assign menu = linklists[section.settings.menu]
  assign wa_digits = settings.yh_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign wa_text = settings.yh_whatsapp_message | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_digits
  if wa_text != blank
    assign wa_url = wa_url | append: '?text=' | append: wa_text
  endif
  assign drawer_id = 'YhMenu-' | append: section.id
-%}
{%- capture yh_style -%}
  {%- render 'yh-var', name: '--yh-h-strip', value: section.settings.c_strip -%}
  {%- render 'yh-var', name: '--yh-h-bg', value: section.settings.c_bg -%}
  {%- render 'yh-var', name: '--yh-h-text', value: section.settings.c_text -%}
  {%- render 'yh-var', name: '--yh-h-search', value: section.settings.c_search -%}
  {%- render 'yh-var', name: '--yh-h-search-text', value: section.settings.c_search_text -%}
  {%- render 'yh-var', name: '--yh-h-icon-bg', value: section.settings.c_icon_bg -%}
  {%- render 'yh-var', name: '--yh-h-cart', value: section.settings.c_cart -%}
  {%- render 'yh-var', name: '--yh-h-cart-text', value: section.settings.c_cart_text -%}
  {%- render 'yh-var', name: '--yh-h-count', value: section.settings.c_count -%}
  {%- render 'yh-var', name: '--yh-h-count-text', value: section.settings.c_count_text -%}
  {%- render 'yh-var', name: '--yh-n-bg', value: section.settings.c_nav -%}
  {%- render 'yh-var', name: '--yh-n-text', value: section.settings.c_nav_text -%}
  {%- render 'yh-var', name: '--yh-n-active', value: section.settings.c_nav_active -%}
  {%- render 'yh-var', name: '--yh-n-active-text', value: section.settings.c_nav_active_text -%}
  {%- render 'yh-var', name: '--yh-n-deals', value: section.settings.c_nav_deals -%}
  {%- render 'yh-var', name: '--yh-n-contact', value: section.settings.c_nav_contact -%}
{%- endcapture -%}
<div class="yh-header" data-yh-header style="{{ yh_style }}">
  <div class="yh-wrap">
    <div class="yh-bar">
      <button
        type="button"
        class="yh-roundbtn yh-menubtn"
        data-yh-menu-open
        aria-controls="{{ drawer_id }}"
        aria-expanded="false"
        aria-label="{{ section.settings.menu_button_label | escape }}"
      >
        {%- render 'yh-icon', icon: 'menu', size: 22 -%}
      </button>

      <a href="{{ routes.root_url }}" class="yh-logo{% if section.settings.logo_white %} yh-logo--white{% endif %}" style="--yh-logo-width: {{ settings.logo_width }}px">
        {%- if logo != blank -%}
          {%- assign logo_2x = settings.logo_width | times: 2 -%}
          {{ logo | image_url: width: logo_2x | image_tag: alt: logo_alt, loading: 'eager', fetchpriority: 'high' }}
        {%- else -%}
          <span class="yh-logo__text">{{ shop.name | escape }}</span>
        {%- endif -%}
      </a>

      <form action="{{ routes.search_url }}" method="get" role="search" class="yh-search">
        {%- render 'yh-icon', icon: 'search', size: 18 -%}
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ section.settings.search_placeholder | escape }}"
          aria-label="{{ 'general.search.search' | t }}"
        >
      </form>

      <div class="yh-bar__actions">
        {%- if shop.customer_accounts_enabled -%}
          <shopify-account
            menu="{{ settings.customer_account_menu | default: 'customer-account-main-menu' }}"
            class="yh-roundbtn yh-account"
          >
            <span slot="signed-out-avatar" class="yh-roundbtn__inner">
              {%- render 'yh-icon', icon: 'user', size: 20 -%}
              <span class="visually-hidden">{{ section.settings.account_label | escape }}</span>
            </span>
          </shopify-account>
        {%- endif -%}
        <a href="{{ routes.cart_url }}" class="yh-cartbtn" id="cart-icon-bubble">
          {%- render 'yh-icon', icon: 'cart', size: 19 -%}
          <span class="yh-cartbtn__label">{{ 'templates.cart.cart' | t }}</span>
          <span class="yh-cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" aria-hidden="true">{{ cart.item_count | at_most: 99 }}</span>
          <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
        </a>
      </div>
    </div>

    {%- if section.settings.show_nav -%}
      <nav class="yh-nav" aria-label="{{ section.settings.nav_label | escape }}">
        {%- if section.settings.show_deals and section.settings.deals_label != blank -%}
          <a href="{{ section.settings.deals_link | default: routes.all_products_collection_url }}" class="yh-nav__link yh-nav__link--deals">
            {%- render 'yh-icon', icon: 'bolt', size: 16 -%}{{ section.settings.deals_label | escape }}
          </a>
        {%- endif -%}
        {%- if menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <details class="yh-nav__group" data-yh-dropdown>
                <summary class="yh-nav__link{% if link.active or link.child_active %} is-active{% endif %}">
                  {{- link.title | escape -}}{%- render 'yh-icon', icon: 'chevron-down', size: 15 -%}
                </summary>
                <div class="yh-nav__drop">
                  {%- if link.url != '#' and section.settings.view_all_label != blank -%}
                    <a href="{{ link.url }}" class="yh-nav__droplink yh-nav__droplink--all">{{ section.settings.view_all_label | escape }}</a>
                  {%- endif -%}
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="yh-nav__droplink{% if child.active %} is-active{% endif %}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    {%- for grandchild in child.links -%}
                      <a href="{{ grandchild.url }}" class="yh-nav__droplink yh-nav__droplink--sub{% if grandchild.active %} is-active{% endif %}">{{ grandchild.title | escape }}</a>
                    {%- endfor -%}
                  {%- endfor -%}
                </div>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="yh-nav__link{% if link.active %} is-active{% endif %}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for c in collections limit: 12 -%}
            {%- if c.handle == 'frontpage' or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
            <a href="{{ c.url }}" class="yh-nav__link{% if collection.handle == c.handle %} is-active{% endif %}">{{ c.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.show_contact and section.settings.contact_label != blank and wa_digits != blank -%}
          <a href="{{ wa_url }}" target="_blank" rel="noopener" class="yh-nav__link yh-nav__link--contact">
            {%- render 'yh-icon', icon: 'chat', size: 16 -%}{{ section.settings.contact_label | escape }}
          </a>
        {%- endif -%}
      </nav>
    {%- endif -%}
  </div>

  <div class="yh-drawer" id="{{ drawer_id }}" data-yh-menu hidden>
    <div class="yh-drawer__shade" data-yh-menu-close></div>
    <div class="yh-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ section.settings.drawer_title | escape }}" tabindex="-1">
      <div class="yh-drawer__head">
        <span class="yh-drawer__title">{{ section.settings.drawer_title | escape }}</span>
        <button type="button" class="yh-roundbtn" data-yh-menu-close aria-label="{{ 'accessibility.close' | t }}">
          {%- render 'yh-icon', icon: 'x', size: 20 -%}
        </button>
      </div>
      <nav class="yh-drawer__nav" aria-label="{{ section.settings.nav_label | escape }}">
        {%- if section.settings.show_deals and section.settings.deals_label != blank -%}
          <a href="{{ section.settings.deals_link | default: routes.all_products_collection_url }}" class="yh-drawer__link yh-drawer__link--deals">
            <span>{%- render 'yh-icon', icon: 'bolt', size: 18 -%}{{ section.settings.deals_label | escape }}</span>
          </a>
        {%- endif -%}
        {%- if menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              <details class="yh-drawer__group"{% if link.child_active %} open{% endif %}>
                <summary class="yh-drawer__link{% if link.active or link.child_active %} is-current{% endif %}">
                  <span>{{ link.title | escape }}</span>{%- render 'yh-icon', icon: 'chevron-down', size: 18 -%}
                </summary>
                <div class="yh-drawer__sub">
                  {%- if link.url != '#' and section.settings.view_all_label != blank -%}
                    <a href="{{ link.url }}" class="yh-drawer__sublink yh-drawer__sublink--all">{{ section.settings.view_all_label | escape }}</a>
                  {%- endif -%}
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="yh-drawer__sublink{% if child.active %} is-current{% endif %}"{% if child.active %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
                    {%- for grandchild in child.links -%}
                      <a href="{{ grandchild.url }}" class="yh-drawer__sublink yh-drawer__sublink--sub{% if grandchild.active %} is-current{% endif %}">{{ grandchild.title | escape }}</a>
                    {%- endfor -%}
                  {%- endfor -%}
                </div>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="yh-drawer__link{% if link.active %} is-current{% endif %}"{% if link.active %} aria-current="page"{% endif %}><span>{{ link.title | escape }}</span></a>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for c in collections limit: 20 -%}
            {%- if c.handle == 'frontpage' or c.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
            <a href="{{ c.url }}" class="yh-drawer__link{% if collection.handle == c.handle %} is-current{% endif %}"><span>{{ c.title | escape }}</span></a>
          {%- endfor -%}
        {%- endif -%}
      </nav>
      <div class="yh-drawer__foot">
        {%- if shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="yh-drawer__account">
            {%- render 'yh-icon', icon: 'user', size: 20 -%}{{ section.settings.account_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.show_contact and section.settings.contact_label != blank and wa_digits != blank -%}
          <a href="{{ wa_url }}" target="_blank" rel="noopener" class="yh-drawer__wa">
            {%- render 'yh-icon', icon: 'whatsapp', size: 20 -%}{{ section.settings.contact_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "url": {{ request.origin | append: page.url | json }}
  }
</script>
{%- if request.page_type == 'index' -%}
  {%- assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Yalla Haul header",
  "class": "yh-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Empty = the logo from Theme settings > Logo, or the store name. Width: Theme settings > Logo."
    },
    {
      "type": "checkbox",
      "id": "logo_white",
      "label": "Make the logo all white",
      "info": "For a dark header background. Off = your logo in its own colours.",
      "default": false
    },
    { "type": "text", "id": "search_placeholder", "label": "Search box text", "default": "Search tissues, cleaning, kitchen..." },
    { "type": "text", "id": "account_label", "label": "Account link name", "default": "My account" },
    { "type": "header", "content": "Menu" },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Edit it in Online Store > Navigation. Items with sub-items open a dropdown (a list on phones)."
    },
    { "type": "checkbox", "id": "show_nav", "label": "Show the nav bar on computers", "default": true },
    { "type": "text", "id": "view_all_label", "label": "First line of each dropdown (empty hides it)", "default": "View all" },
    { "type": "text", "id": "drawer_title", "label": "Phone menu title", "default": "Menu" },
    { "type": "text", "id": "menu_button_label", "label": "Phone menu button name (screen readers)", "default": "Open menu" },
    { "type": "text", "id": "nav_label", "label": "Menu name (screen readers)", "default": "Main menu" },
    { "type": "header", "content": "Extra links" },
    { "type": "checkbox", "id": "show_deals", "label": "Add a red lightning link before the menu", "default": false },
    { "type": "text", "id": "deals_label", "label": "Lightning link text", "default": "Flash deals" },
    { "type": "url", "id": "deals_link", "label": "Lightning link goes to (empty = all products)" },
    {
      "type": "checkbox",
      "id": "show_contact",
      "label": "Add a WhatsApp link after the menu",
      "info": "Uses the WhatsApp number in Theme settings > Yalla Haul.",
      "default": true
    },
    { "type": "text", "id": "contact_label", "label": "WhatsApp link text", "default": "Contact us" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_strip", "label": "Behind the bars", "default": "#fbf6f1" },
    { "type": "color", "id": "c_bg", "label": "Top bar", "default": "#ffffff" },
    { "type": "color", "id": "c_text", "label": "Top bar text and icons", "default": "#171717" },
    { "type": "color", "id": "c_search", "label": "Search box", "default": "#fbf6f1" },
    { "type": "color", "id": "c_search_text", "label": "Search box text", "default": "#171717" },
    { "type": "color", "id": "c_icon_bg", "label": "Round buttons", "default": "#fbf6f1" },
    { "type": "color", "id": "c_cart", "label": "Cart button", "default": "#d42a2a" },
    { "type": "color", "id": "c_cart_text", "label": "Cart button text", "default": "#ffffff" },
    { "type": "color", "id": "c_count", "label": "Cart count", "default": "#ffffff" },
    { "type": "color", "id": "c_count_text", "label": "Cart count text", "default": "#d42a2a" },
    { "type": "color", "id": "c_nav", "label": "Nav bar and phone menu", "default": "#ffffff" },
    { "type": "color", "id": "c_nav_text", "label": "Menu links", "default": "#171717" },
    { "type": "color", "id": "c_nav_active", "label": "Current page link", "default": "#171717" },
    { "type": "color", "id": "c_nav_active_text", "label": "Current page link text", "default": "#ffffff" },
    { "type": "color", "id": "c_nav_deals", "label": "Lightning link", "default": "#d42a2a" },
    { "type": "color", "id": "c_nav_contact", "label": "WhatsApp link", "default": "#1a9e4b" }
  ]
}
{% endschema %}

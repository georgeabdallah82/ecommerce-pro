{%- comment -%}
  Red band above the footer: "Need help with your order?" and a WhatsApp button. Hidden when
  no WhatsApp number is set (Theme settings > Yalla Haul).
{%- endcomment -%}
{%- assign wa_digits = settings.yh_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
{%- if wa_digits != blank -%}
  {%- assign wa_text = settings.yh_whatsapp_message | url_encode -%}
  <div class="yh-help">
    <div class="yh-wrap yh-help__inner">
      <span>{{ section.settings.text | escape }}</span>
      <a href="https://wa.me/{{ wa_digits }}{% if wa_text != blank %}?text={{ wa_text }}{% endif %}" target="_blank" rel="noopener" class="yh-help__btn">
        {%- render 'yh-icon', icon: 'chat', size: 16 -%}{{ section.settings.button | escape }}
      </a>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Yalla Haul help bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Need help with your order?" },
    { "type": "text", "id": "button", "label": "Button", "default": "WhatsApp us" }
  ]
}
{% endschema %}

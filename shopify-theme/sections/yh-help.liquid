{%- comment -%}
  "Need help with your order?" card with a WhatsApp button. Hidden when no WhatsApp number is
  set (Theme settings > Yalla Haul).
{%- endcomment -%}
{%- assign wa_digits = settings.yh_whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' -%}
{%- if wa_digits != blank -%}
  {%- assign wa_text = settings.yh_whatsapp_message | url_encode -%}
  <div class="yh-section">
    <div class="yh-wrap">
      <div class="yh-help">
        <div>
          <b>{{ section.settings.heading | escape }}</b>
          {%- if section.settings.text != blank -%}<span>{{ section.settings.text | escape }}</span>{%- endif -%}
        </div>
        <a href="https://wa.me/{{ wa_digits }}{% if wa_text != blank %}?text={{ wa_text }}{% endif %}" target="_blank" rel="noopener" class="yh-help__btn">
          {%- render 'yh-icon', icon: 'whatsapp', size: 20 -%}{{ section.settings.button | escape }}
        </a>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Yalla Haul WhatsApp help",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Need help with your order?" },
    { "type": "text", "id": "text", "label": "Text", "default": "Message us on WhatsApp, we reply fast." },
    { "type": "text", "id": "button", "label": "Button", "default": "WhatsApp us" }
  ],
  "presets": [{ "name": "Yalla Haul WhatsApp help" }]
}
{% endschema %}

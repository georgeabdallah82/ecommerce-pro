{%- comment -%}
  Hero banner in the Bento style: a big rounded banner with a photo, heading (some words in the
  accent colour), text and up to two buttons. Two layouts: the photo fills the banner behind the
  text, or a colour panel with the photo beside it (above it on phones). On the home page it
  ships hidden; show it with the eye icon in the theme editor.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading | escape
  assign highlight = section.settings.highlight | escape
  if highlight != blank and heading contains highlight
    assign highlight_html = '<span>' | append: highlight | append: '</span>'
    assign heading = heading | replace_first: highlight, highlight_html
  endif
  assign has_photo = false
  if section.settings.image != blank or section.settings.stock != 'none'
    assign has_photo = true
  endif
-%}
{%- capture yh_style -%}
  {%- render 'yh-var', name: '--yh-hr-bg', value: section.settings.c_bg -%}
  {%- render 'yh-var', name: '--yh-hr-text', value: section.settings.c_text -%}
  {%- render 'yh-var', name: '--yh-hr-hl', value: section.settings.c_highlight -%}
  {%- render 'yh-var', name: '--yh-hr-btn', value: section.settings.c_btn -%}
  {%- render 'yh-var', name: '--yh-hr-btn-text', value: section.settings.c_btn_text -%}
  --yh-hr-shade: {{ section.settings.overlay | divided_by: 100.0 }};
{%- endcapture -%}
<div class="yh-section yh-section--top">
  <div class="yh-wrap">
    <div
      class="yh-hero yh-hero--{{ section.settings.layout }} yh-hero--{{ section.settings.height }} yh-hero--{{ section.settings.align }}{% if has_photo %} yh-hero--has-photo{% endif %}"
      style="{{ yh_style }}"
    >
      {%- if has_photo -%}
        <div class="yh-hero__media">
          {%- render 'yh-photo',
            image: section.settings.image,
            stock: section.settings.stock,
            class: 'yh-cover',
            widths: '600, 900, 1200, 1600, 2000',
            sizes: '(min-width: 1280px) 1232px, 100vw',
            eager: true
          -%}
        </div>
      {%- endif -%}
      <div class="yh-hero__copy">
        {%- if section.settings.label != blank -%}
          <span class="yh-hero__label">{{ section.settings.label | escape }}</span>
        {%- endif -%}
        <h2 class="yh-hero__title">{{ heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="yh-hero__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button != blank or section.settings.button2 != blank -%}
          <div class="yh-hero__btns">
            {%- if section.settings.button != blank -%}
              <a href="{{ section.settings.link | default: routes.all_products_collection_url }}" class="yh-hero__btn">
                {{- section.settings.button | escape -}}{%- render 'yh-icon', icon: 'arrow', size: 18 -%}
              </a>
            {%- endif -%}
            {%- if section.settings.button2 != blank -%}
              <a href="{{ section.settings.link2 | default: routes.collections_url }}" class="yh-hero__btn yh-hero__btn--outline">{{ section.settings.button2 | escape }}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul hero banner",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "photo", "label": "Photo behind the text" },
        { "value": "split", "label": "Colour panel with the photo beside it" }
      ],
      "default": "photo"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "align",
      "label": "Text position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centre" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    {
      "type": "select",
      "id": "stock",
      "label": "Built-in photo (when there is no photo)",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "hero-kitchen", "label": "Kitchen" },
        { "value": "hero-rolls", "label": "Paper rolls" },
        { "value": "hero-bottles", "label": "Bottles" },
        { "value": "offer-home", "label": "Living room" },
        { "value": "offer-care", "label": "Personal care" },
        { "value": "spot-cleaning", "label": "Cleaning" }
      ],
      "default": "hero-kitchen"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darken the photo (photo behind the text)",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    { "type": "text", "id": "label", "label": "Small label above (empty hides it)", "default": "DELIVERED ALL OVER LEBANON" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Make home feel easy." },
    {
      "type": "text",
      "id": "highlight",
      "label": "Words in the highlight colour",
      "info": "Must appear in the heading exactly as written. Empty = none."
    },
    { "type": "text", "id": "text", "label": "Text", "default": "Everyday essentials, delivered in 2-3 days. Pay cash at your door." },
    { "type": "text", "id": "button", "label": "Button (empty hides it)", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Button link (empty = all products)" },
    { "type": "text", "id": "button2", "label": "Second button (empty hides it)" },
    { "type": "url", "id": "link2", "label": "Second button link (empty = all collections)" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_bg", "label": "Background (panel, or behind the photo)", "default": "#d42a2a" },
    { "type": "color", "id": "c_text", "label": "Text", "default": "#ffffff" },
    { "type": "color", "id": "c_highlight", "label": "Highlighted words and label", "default": "#ff7a1a" },
    { "type": "color", "id": "c_btn", "label": "Button", "default": "#ff7a1a" },
    { "type": "color", "id": "c_btn_text", "label": "Button text", "default": "#171717" }
  ],
  "presets": [{ "name": "Yalla Haul hero banner" }]
}
{% endschema %}

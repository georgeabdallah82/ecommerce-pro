<section class="yh-market-section yhm-categories-section">
  <div class="yhm-section-heading"><div><span class="yhm-section-kicker">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div>{% if section.settings.link_label != blank %}<a class="yhm-text-link" href="{{ routes.collections_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}</div>
  <div class="yhm-category-grid">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- if c != blank -%}
        <a class="yhm-category-card" href="{{ c.url }}" {{ block.shopify_attributes }}>
          <span class="yhm-category-image">
            {%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 600 | image_tag: widths: '160, 260, 400, 600', sizes: '(min-width: 760px) 16vw, 35vw', loading: 'lazy', alt: c.title }}
            {%- elsif c.image != blank -%}{{ c.image | image_url: width: 600 | image_tag: widths: '160, 260, 400, 600', sizes: '(min-width: 760px) 16vw, 35vw', loading: 'lazy', alt: c.title }}
            {%- else -%}<span class="yhm-category-placeholder">YH</span>{%- endif -%}
          </span>
          <span class="yhm-category-name">{{ block.settings.label | default: c.title | escape }}</span>
          {% if section.settings.show_count %}<span class="yhm-category-count">{{ c.products_count }} items</span>{% endif %}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name":"YH market categories",
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"FIND YOUR FAVOURITES"},
    {"type":"text","id":"heading","label":"Heading","default":"Shop by category"},
    {"type":"text","id":"link_label","label":"Link label","default":"View all"},
    {"type":"checkbox","id":"show_count","label":"Show item count","default":false}
  ],
  "blocks":[{"type":"category","name":"Category","settings":[
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"image_picker","id":"image","label":"Override image"},
    {"type":"text","id":"label","label":"Custom label"}
  ]}],
  "max_blocks":12,
  "presets":[{"name":"YH market categories","blocks":[{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"},{"type":"category"}]}
  ]
}
{% endschema %}

{%- liquid
  assign slide_count = section.blocks.size
-%}
<section class="yh-market-section yh-market-hero-section" data-yhm-slider data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.speed }}">
  <div class="yhm-hero">
    <div class="yhm-hero-track" data-yhm-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign hero_image = block.settings.image
          assign fallback_asset = 'yh-hero-kitchen.jpg'
          if forloop.index == 2
            assign fallback_asset = 'yh-hero-rolls.jpg'
          elsif forloop.index == 3
            assign fallback_asset = 'yh-hero-bottles.jpg'
          endif
        -%}
        <article class="yhm-hero-slide{% if forloop.first %} is-active{% endif %}" data-yhm-slide {{ block.shopify_attributes }}>
          {%- if hero_image != blank -%}
            {{ hero_image | image_url: width: 2200 | image_tag: class: 'yhm-hero-image', widths: '750, 1100, 1500, 1800, 2200', sizes: '100vw', loading: 'eager', alt: block.settings.image_alt }}
          {%- else -%}
            <img class="yhm-hero-image" src="{{ fallback_asset | asset_url }}" alt="{{ block.settings.image_alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}">
          {%- endif -%}
          <div class="yhm-hero-shade"></div>
          <div class="yhm-hero-copy">
            {%- if block.settings.eyebrow != blank -%}<span class="yhm-eyebrow">{{ block.settings.eyebrow | escape }}</span>{%- endif -%}
            <h1>{% if block.settings.heading != blank %}{{ block.settings.heading | escape }}{% else %}Everything you need,{% endif %} {% if block.settings.highlight != blank %}<em>{{ block.settings.highlight | escape }}</em>{% endif %}</h1>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
            <div class="yhm-hero-buttons">
              {%- if block.settings.button_label != blank -%}<a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="yhm-btn yhm-btn--primary">{{ block.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{%- endif -%}
              {%- if block.settings.secondary_label != blank -%}<a href="{{ block.settings.secondary_link | default: routes.collections_url }}" class="yhm-btn yhm-btn--outline">{{ block.settings.secondary_label | escape }}</a>{%- endif -%}
            </div>
          </div>
          {%- if block.settings.badge != blank -%}<span class="yhm-hero-badge">{{ block.settings.badge | escape }}</span>{%- endif -%}
        </article>
      {%- else -%}
        <article class="yhm-hero-slide is-active">
          <img class="yhm-hero-image" src="{{ 'yh-hero-kitchen.jpg' | asset_url }}" alt="" loading="eager"><div class="yhm-hero-shade"></div>
          <div class="yhm-hero-copy"><span class="yhm-eyebrow">Yalla Haul</span><h1>Everyday essentials, <em>made easy.</em></h1><p>Useful finds for your home and routine, delivered across Lebanon.</p><a class="yhm-btn yhm-btn--primary" href="{{ routes.all_products_collection_url }}">Shop now →</a></div>
        </article>
      {%- endfor -%}
    </div>
    {%- if slide_count > 1 -%}
      <button class="yhm-hero-arrow yhm-hero-arrow--prev" type="button" data-yhm-prev aria-label="Previous slide">‹</button>
      <button class="yhm-hero-arrow yhm-hero-arrow--next" type="button" data-yhm-next aria-label="Next slide">›</button>
      <div class="yhm-hero-dots" aria-label="Choose slide">
        {%- for block in section.blocks -%}<button type="button" data-yhm-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}" {% if forloop.first %}aria-current="true"{% endif %}></button>{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name":"YH market hero",
  "settings":[
    {"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},
    {"type":"range","id":"speed","label":"Slide duration (seconds)","min":3,"max":10,"step":1,"default":5}
  ],
  "blocks":[
    {"type":"slide","name":"Hero slide","settings":[
      {"type":"image_picker","id":"image","label":"Desktop image"},
      {"type":"text","id":"image_alt","label":"Image alt text"},
      {"type":"text","id":"eyebrow","label":"Eyebrow","default":"EVERYDAY ESSENTIALS"},
      {"type":"text","id":"heading","label":"Heading","default":"Everything for your home,"},
      {"type":"text","id":"highlight","label":"Highlighted words","default":"delivered"},
      {"type":"textarea","id":"text","label":"Text","default":"Practical finds for home and personal care, delivered across Lebanon."},
      {"type":"text","id":"button_label","label":"Button label","default":"Shop now"},
      {"type":"url","id":"button_link","label":"Button link"},
      {"type":"text","id":"secondary_label","label":"Secondary button label","default":"Browse collections"},
      {"type":"url","id":"secondary_link","label":"Secondary button link"},
      {"type":"text","id":"badge","label":"Small badge"}
    ]},
    {"type":"_presets","name":"Defaults"}
  ],
  "presets":[
    {"name":"YH market hero","blocks":[
      {"type":"slide","settings":{"eyebrow":"HOME ESSENTIALS","heading":"Everything for your home,","highlight":"delivered","text":"Everyday essentials, with cash on delivery across Lebanon.","button_label":"Shop now","secondary_label":"Browse collections"}},
      {"type":"slide","settings":{"eyebrow":"STOCK UP","heading":"Small things that make","highlight":"life easier","text":"Discover useful finds for every corner of your home.","button_label":"Shop all","secondary_label":""}},
      {"type":"slide","settings":{"eyebrow":"PERSONAL CARE","heading":"Refresh your daily","highlight":"routine","text":"Find your everyday favourites in one easy haul.","button_label":"Discover more","secondary_label":""}}
    ]}
  ]
}
{% endschema %}

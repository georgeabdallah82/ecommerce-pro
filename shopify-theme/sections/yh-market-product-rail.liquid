{%- liquid
  assign c = section.settings.collection
  if c == blank
    assign c = collections.all
  endif
-%}
<section class="yh-market-section yhm-rail-section">
  <div class="yhm-section-heading"><div><span class="yhm-section-kicker">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}</div><a class="yhm-text-link" href="{{ c.url | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a></div>
  <div class="yhm-rail-wrap"><div class="yhm-product-rail" data-yhm-rail>
    {%- for product in c.products limit: section.settings.limit -%}<div class="yhm-rail-card">{% render 'yh-card', card_product: product, section_id: section.id, eager: forloop.index <= 2 %}</div>{%- else -%}<p class="yhm-empty-note">Add products to this collection to show them here.</p>{%- endfor -%}
  </div></div>
</section>
{% schema %}
{
  "name":"YH market product rail",
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"CUSTOMER FAVOURITES"},
    {"type":"text","id":"heading","label":"Heading","default":"Best sellers"},
    {"type":"text","id":"subheading","label":"Subheading","default":"The little things people keep coming back for."},
    {"type":"collection","id":"collection","label":"Collection"},
    {"type":"range","id":"limit","label":"Maximum products","min":4,"max":16,"step":2,"default":8},
    {"type":"text","id":"link_label","label":"Link label","default":"See all"}
  ],
  "presets":[{"name":"YH market product rail"}]
}
{% endschema %}

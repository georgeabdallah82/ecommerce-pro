{%- liquid
  assign active_tab = 0
  if section.settings.active_tab != blank
    assign active_tab = section.settings.active_tab | plus: 0
  endif
-%}
<section class="yh-market-section yhm-tabs-section" data-yhm-tabs>
  <div class="yhm-section-heading"><div><span class="yhm-section-kicker">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.subheading != blank %}<p>{{ section.settings.subheading | escape }}</p>{% endif %}</div></div>
  <div class="yhm-tab-list" role="tablist" aria-label="{{ section.settings.heading | escape }}">
    {%- for block in section.blocks -%}
      <button type="button" class="yhm-tab-button{% if forloop.first %} is-active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="YhmTab-{{ section.id }}-{{ forloop.index }}" data-yhm-tab="{{ forloop.index0 }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</button>
    {%- endfor -%}
  </div>
  {%- for block in section.blocks -%}
    {%- liquid
      assign chosen_collection = block.settings.collection
      if chosen_collection == blank
        assign chosen_collection = collections.all
      endif
      assign chosen_products = chosen_collection.products
      if block.settings.sort_by == 'newest'
        assign chosen_products = chosen_collection.products | sort: 'published_at' | reverse
      endif
    -%}
    <div id="YhmTab-{{ section.id }}-{{ forloop.index }}" class="yhm-tab-panel{% if forloop.first %} is-active{% endif %}" role="tabpanel" data-yhm-panel="{{ forloop.index0 }}" {% unless forloop.first %}hidden{% endunless %}>
      <div class="yhm-product-grid yhm-product-grid--{{ section.settings.columns }}">
        {%- assign shown = 0 -%}
        {%- for product in chosen_products limit: section.settings.limit -%}
          {%- if block.type == 'deals' -%}
            {%- if product.compare_at_price > product.price -%}
              {%- render 'yh-card', card_product: product, section_id: section.id, eager: forloop.first -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- else -%}
            {%- render 'yh-card', card_product: product, section_id: section.id, eager: forloop.first -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if shown == 0 -%}<p class="yhm-empty-note">Products will appear here as soon as this collection has items.</p>{%- endif -%}
      </div>
    </div>
  {%- endfor -%}
  {%- if section.settings.link_label != blank -%}<div class="yhm-section-bottom"><a class="yhm-btn yhm-btn--soft" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">→</span></a></div>{%- endif -%}
</section>
{% schema %}
{
  "name":"YH market product tabs",
  "settings":[
    {"type":"text","id":"kicker","label":"Kicker","default":"WHAT'S WORTH A LOOK"},
    {"type":"text","id":"heading","label":"Heading","default":"Popular right now"},
    {"type":"text","id":"subheading","label":"Subheading","default":"Find your next favourite."},
    {"type":"range","id":"limit","label":"Products per tab","min":4,"max":16,"step":4,"default":8},
    {"type":"select","id":"columns","label":"Desktop columns","options":[{"value":"3","label":"3"},{"value":"4","label":"4"},{"value":"5","label":"5"}],"default":"4"},
    {"type":"text","id":"link_label","label":"Bottom link label","default":"View all products"},
    {"type":"url","id":"link","label":"Bottom link"}
  ],
  "blocks":[
    {"type":"collection","name":"Collection tab","settings":[{"type":"text","id":"label","label":"Tab label","default":"Popular"},{"type":"collection","id":"collection","label":"Collection"},{"type":"select","id":"sort_by","label":"Product order","options":[{"value":"manual","label":"Collection order"},{"value":"newest","label":"Newest first"}],"default":"manual"}]},
    {"type":"deals","name":"Sale items tab","settings":[{"type":"text","id":"label","label":"Tab label","default":"Deals"},{"type":"collection","id":"collection","label":"Collection with sale items"}]}
  ],
  "max_blocks":4,
  "presets":[{"name":"YH market product tabs","blocks":[{"type":"collection","settings":{"label":"Popular"}},{"type":"deals","settings":{"label":"Today's deals"}},{"type":"collection","settings":{"label":"New arrivals"}}]}]
}
{% endschema %}

{%- comment -%}
  One to three photo banners side by side, each with a small tag, a title and a link.
{%- endcomment -%}
<div class="yh-section yh-offers-sec">
  <div class="yh-wrap yh-offers yh-offers--{{ section.blocks.size | at_most: 3 }}">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="yh-offer" {{ block.shopify_attributes }}>
        {%- render 'yh-photo',
          image: block.settings.image,
          stock: block.settings.stock,
          widths: '400, 600, 900, 1200',
          sizes: '(min-width: 750px) 50vw, 100vw',
          class: 'yh-cover'
        -%}
        <span class="yh-offer__text">
          {%- if block.settings.tag != blank -%}<small>{{ block.settings.tag | escape }}</small>{%- endif -%}
          {%- if block.settings.title != blank -%}<b>{{ block.settings.title | escape }}</b>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<u>{{ block.settings.link_label | escape }}</u>{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul offer banners",
  "tag": "section",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "offer",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select",
          "id": "stock",
          "label": "Built-in photo (used when no photo is uploaded)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "offer-home", "label": "Living room" },
            { "value": "offer-care", "label": "Personal care" },
            { "value": "spot-cleaning", "label": "Cleaning" },
            { "value": "hero-kitchen", "label": "Kitchen" },
            { "value": "hero-rolls", "label": "Paper rolls" },
            { "value": "hero-bottles", "label": "Bottles" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "tag", "label": "Tag", "default": "Home" },
        { "type": "text", "id": "title", "label": "Title", "default": "Everyday home essentials" },
        { "type": "text", "id": "link_label", "label": "Link text", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yalla Haul offer banners",
      "blocks": [
        { "type": "offer", "settings": { "stock": "offer-home" } },
        { "type": "offer", "settings": { "stock": "offer-care", "tag": "Personal care", "title": "Care for the whole family" } }
      ]
    }
  ]
}
{% endschema %}

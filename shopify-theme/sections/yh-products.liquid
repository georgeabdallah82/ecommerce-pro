{%- comment -%}
  Products from a collection in a white panel ("Today's best deals"): heading with an icon,
  optional countdown to midnight, "See all" link, and a grid of cards (six across on
  computers, two on phones).
{%- endcomment -%}
{%- liquid
  assign c = section.settings.collection
  if c == blank or c.products_count == 0
    assign c = collections.all
  endif
  assign limit = section.settings.limit
-%}
{%- capture yh_style -%}
  {%- render 'yh-var', name: '--yh-p-bg', value: section.settings.c_panel -%}
  {%- render 'yh-var', name: '--yh-p-heading', value: section.settings.c_heading -%}
  {%- render 'yh-var', name: '--yh-p-icon', value: section.settings.c_icon -%}
  {%- render 'yh-var', name: '--yh-p-link', value: section.settings.c_link -%}
  {%- render 'yh-var', name: '--yh-p-timer', value: section.settings.c_timer -%}
  {%- render 'yh-var', name: '--yh-p-timer-text', value: section.settings.c_timer_text -%}
{%- endcapture -%}
<div class="yh-section" style="{{ yh_style }}">
  <div class="yh-wrap">
    <div class="yh-panel">
      <div class="yh-head">
        <div class="yh-head__title">
          <h2>
            {%- if section.settings.icon != 'none' -%}{%- render 'yh-icon', icon: section.settings.icon, size: 22 -%}{%- endif -%}
            {{- section.settings.heading | default: c.title | escape -}}
          </h2>
          {%- if section.settings.timer -%}
            <span class="yh-timer" data-yh-timer role="timer" aria-label="{{ section.settings.timer_label | escape }}">
              <b data-h>00</b><b data-m>00</b><b data-s>00</b>
            </span>
          {%- endif -%}
        </div>
        {%- if section.settings.link_label != blank -%}
          <a href="{{ c.url | default: routes.all_products_collection_url }}" class="yh-link">{{ section.settings.link_label | escape }}</a>
        {%- endif -%}
      </div>
      <div class="yh-grid" style="--yh-cols: {{ section.settings.columns }}">
        {%- if c.products_count > 0 -%}
          {%- for product in c.products limit: limit -%}
            {%- render 'yh-card', card_product: product, section_id: section.id -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..section.settings.columns) -%}
            {%- render 'yh-card', card_product: blank, section_id: section.id -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Yalla Haul products",
  "tag": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (empty = all products)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (empty = collection name)",
      "default": "Today's best deals"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon before the heading",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "bolt",
          "label": "Lightning"
        },
        {
          "value": "fire",
          "label": "Flame"
        },
        {
          "value": "tag",
          "label": "Price tag"
        }
      ],
      "default": "bolt"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "\"See all\" link",
      "default": "See all"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row on computers",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "timer",
      "label": "Show a countdown to midnight",
      "default": false
    },
    {
      "type": "text",
      "id": "timer_label",
      "label": "Countdown name for screen readers",
      "default": "Time left today"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "c_panel",
      "label": "Panel background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "c_heading",
      "label": "Heading",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "c_icon",
      "label": "Heading icon",
      "default": "#ff7a1a"
    },
    {
      "type": "color",
      "id": "c_link",
      "label": "\"See all\" link",
      "default": "#d42a2a"
    },
    {
      "type": "color",
      "id": "c_timer",
      "label": "Countdown boxes",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "c_timer_text",
      "label": "Countdown numbers",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Yalla Haul products"
    }
  ]
}
{% endschema %}

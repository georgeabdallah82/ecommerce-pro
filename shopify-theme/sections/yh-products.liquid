{%- comment -%}
  A row of product cards from a collection: five across on computers, swipeable on phones.
{%- endcomment -%}
{%- liquid
  assign c = section.settings.collection
  if c == blank or c.products_count == 0
    assign c = collections.all
  endif
  assign limit = section.settings.limit
-%}
<div class="yh-section">
  <div class="yh-wrap">
    <div class="yh-head">
      <div>
        <h2>{{ section.settings.heading | default: c.title | escape }}</h2>
        {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading | escape }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ c.url | default: routes.all_products_collection_url }}" class="yh-link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="yh-grid">
      {%- if c.products_count > 0 -%}
        {%- for product in c.products limit: limit -%}
          {%- render 'yh-card', card_product: product, section_id: section.id -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          {%- render 'yh-card', card_product: blank, section_id: section.id -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Yalla Haul product row",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading (empty = collection name)" },
    { "type": "text", "id": "subheading", "label": "Line under the heading" },
    { "type": "text", "id": "link_label", "label": "\"Shop all\" link", "default": "Shop all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 20, "step": 1, "default": 10 }
  ],
  "presets": [{ "name": "Yalla Haul product row" }]
}
{% endschema %}

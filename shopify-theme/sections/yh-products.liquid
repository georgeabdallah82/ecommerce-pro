{%- comment -%}
  "Popular right now": heading, "See all", a row of category chips (links to collections; hidden
  until there is a category to show) and a grid of product cards (five across on computers, two on
  phones).
{%- endcomment -%}
{%- liquid
  assign c = section.settings.collection
  if c == blank or c.products_count == 0
    assign c = collections.all
  endif
  assign limit = section.settings.limit
  assign chip_menu = linklists[section.settings.chip_menu]
-%}
{%- capture yh_style -%}
  {%- render 'yh-var', name: '--yh-p-heading', value: section.settings.c_heading -%}
  {%- render 'yh-var', name: '--yh-p-icon', value: section.settings.c_icon -%}
  {%- render 'yh-var', name: '--yh-p-link', value: section.settings.c_link -%}
  {%- render 'yh-var', name: '--yh-p-chip', value: section.settings.c_chip -%}
  {%- render 'yh-var', name: '--yh-p-chip-text', value: section.settings.c_chip_text -%}
  {%- render 'yh-var', name: '--yh-p-chip-on', value: section.settings.c_chip_on -%}
  {%- render 'yh-var', name: '--yh-p-chip-on-text', value: section.settings.c_chip_on_text -%}
  {%- render 'yh-var', name: '--yh-p-timer', value: section.settings.c_timer -%}
  {%- render 'yh-var', name: '--yh-p-timer-text', value: section.settings.c_timer_text -%}
{%- endcapture -%}
<div class="yh-section yh-section--products" style="{{ yh_style }}">
  <div class="yh-wrap">
    <div class="yh-head">
      <div class="yh-head__title">
        <h2>
          {%- if section.settings.icon != 'none' -%}{%- render 'yh-icon', icon: section.settings.icon, size: 24 -%}{%- endif -%}
          {{- section.settings.heading | default: c.title | escape -}}
        </h2>
        {%- if section.settings.timer -%}
          <span class="yh-timer" data-yh-timer role="timer" aria-label="{{ section.settings.timer_label | escape }}">
            <b data-h>00</b><b data-m>00</b><b data-s>00</b>
          </span>
        {%- endif -%}
      </div>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ c.url | default: routes.all_products_collection_url }}" class="yh-link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- liquid
      assign chip_count = 0
      if chip_menu.links.size > 0
        assign chip_count = chip_menu.links.size
      else
        for col in collections limit: 50
          if col.handle == 'all' or col.handle == 'frontpage' or col.all_products_count == 0 or col.handle == c.handle
            continue
          endif
          assign chip_count = chip_count | plus: 1
        endfor
      endif
    -%}
    {%- if section.settings.show_chips and chip_count > 0 -%}
      <div class="yh-chips">
        {%- if section.settings.all_chip != blank -%}
          <a href="{{ c.url | default: routes.all_products_collection_url }}" class="yh-chip is-active">{{ section.settings.all_chip | escape }}</a>
        {%- endif -%}
        {%- if chip_menu.links.size > 0 -%}
          {%- for link in chip_menu.links -%}
            <a href="{{ link.url }}" class="yh-chip">{{ link.title | escape }}</a>
          {%- endfor -%}
        {%- else -%}
          {%- for col in collections limit: 12 -%}
            {%- if col.handle == 'all' or col.handle == 'frontpage' or col.all_products_count == 0 or col.handle == c.handle -%}{%- continue -%}{%- endif -%}
            <a href="{{ col.url }}" class="yh-chip">{{ col.title | escape }}</a>
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="yh-grid" style="--yh-cols: {{ section.settings.columns }}">
      {%- if c.products_count > 0 -%}
        {%- for product in c.products limit: limit -%}
          {%- render 'yh-card', card_product: product, section_id: section.id -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.columns) -%}
          {%- render 'yh-card', card_product: blank, section_id: section.id -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Yalla Haul products",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection (empty = all products)" },
    { "type": "text", "id": "heading", "label": "Heading (empty = collection name)", "default": "Popular right now" },
    {
      "type": "select",
      "id": "icon",
      "label": "Icon before the heading",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "bolt", "label": "Lightning" },
        { "value": "fire", "label": "Flame" },
        { "value": "tag", "label": "Price tag" }
      ],
      "default": "none"
    },
    { "type": "text", "id": "link_label", "label": "\"See all\" link", "default": "See all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 24, "step": 1, "default": 12 },
    { "type": "range", "id": "columns", "label": "Products per row on computers", "min": 3, "max": 6, "step": 1, "default": 5 },
    { "type": "checkbox", "id": "timer", "label": "Show a countdown to midnight", "default": false },
    { "type": "text", "id": "timer_label", "label": "Countdown name (screen readers)", "default": "Time left today" },
    { "type": "header", "content": "Category chips" },
    { "type": "checkbox", "id": "show_chips", "label": "Show category chips", "default": true },
    { "type": "text", "id": "all_chip", "label": "First chip (empty hides it)", "default": "All" },
    {
      "type": "link_list",
      "id": "chip_menu",
      "label": "Menu for the chips",
      "info": "Empty = your collections."
    },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "c_heading", "label": "Heading", "default": "#171717" },
    { "type": "color", "id": "c_icon", "label": "Heading icon", "default": "#ff7a1a" },
    { "type": "color", "id": "c_link", "label": "\"See all\" link", "default": "#d42a2a" },
    { "type": "color", "id": "c_chip", "label": "Chips", "default": "#ffffff" },
    { "type": "color", "id": "c_chip_text", "label": "Chip text", "default": "#171717" },
    { "type": "color", "id": "c_chip_on", "label": "First chip", "default": "#171717" },
    { "type": "color", "id": "c_chip_on_text", "label": "First chip text", "default": "#ffffff" },
    { "type": "color", "id": "c_timer", "label": "Countdown boxes", "default": "#171717" },
    { "type": "color", "id": "c_timer_text", "label": "Countdown numbers", "default": "#ffffff" },
    {
      "type": "paragraph",
      "content": "Product card colours (price, label, + button) are in Theme settings > Yalla Haul."
    }
  ],
  "presets": [{ "name": "Yalla Haul products" }]
}
{% endschema %}

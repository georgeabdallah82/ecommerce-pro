{%- comment -%}
  Top of the home page: a big dark banner (several slides swipe like a carousel) and up to two
  smaller photo tiles beside it (under it on phones).
{%- endcomment -%}
{%- liquid
  assign slides = section.blocks | where: 'type', 'slide'
  assign tiles = section.blocks | where: 'type', 'tile'
-%}
<div class="yh-section yh-promo-sec">
  <div class="yh-wrap">
    <div class="yh-promo{% if tiles.size == 0 %} yh-promo--solo{% endif %}">
      <div class="yh-banner" data-yh-slider data-autoplay="{{ section.settings.autoplay }}" aria-roledescription="carousel" aria-label="{{ section.settings.label | escape }}">
        <div class="yh-banner__track" data-yh-track>
          {%- for block in slides -%}
            <div class="yh-slide" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} / {{ forloop.length }}" {{ block.shopify_attributes }}>
              <div class="yh-slide__pic">
                {%- render 'yh-photo',
                  image: block.settings.image,
                  stock: block.settings.stock,
                  widths: '600, 900, 1200, 1600',
                  sizes: '(min-width: 990px) 60vw, 100vw',
                  eager: forloop.first
                -%}
              </div>
              <div class="yh-slide__copy">
                {%- if block.settings.tag != blank -%}<span class="yh-chip">{{ block.settings.tag | escape }}</span>{%- endif -%}
                {%- if block.settings.heading != blank -%}
                  {%- if forloop.first -%}<h1>{{ block.settings.heading | escape }}</h1>{%- else -%}<h2>{{ block.settings.heading | escape }}</h2>{%- endif -%}
                {%- endif -%}
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
                {%- if block.settings.button != blank -%}
                  <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="yh-btn yh-btn--primary">{{ block.settings.button | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
        {%- if slides.size > 1 -%}
          <div class="yh-dots">
            {%- for block in slides -%}
              <button type="button" data-yh-dot="{{ forloop.index0 }}" aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
      {%- if tiles.size > 0 -%}
        <div class="yh-tiles">
          {%- for block in tiles limit: 2 -%}
            <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="yh-tile" {{ block.shopify_attributes }}>
              {%- render 'yh-photo',
                image: block.settings.image,
                stock: block.settings.stock,
                widths: '300, 500, 800',
                sizes: '(min-width: 990px) 30vw, 50vw',
                class: 'yh-cover'
              -%}
              <span class="yh-tile__text">
                {%- if block.settings.title != blank -%}<b>{{ block.settings.title | escape }}</b>{%- endif -%}
                {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
              </span>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul promo banners",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Name for screen readers", "default": "Offers" },
    { "type": "range", "id": "autoplay", "label": "Next slide every (0 = off)", "min": 0, "max": 15, "step": 1, "unit": "s", "default": 6 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Big banner slide",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select",
          "id": "stock",
          "label": "Built-in photo (used when no photo is uploaded)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "hero-kitchen", "label": "Kitchen" },
            { "value": "hero-rolls", "label": "Paper rolls" },
            { "value": "hero-bottles", "label": "Bottles" },
            { "value": "offer-home", "label": "Living room" },
            { "value": "offer-care", "label": "Personal care" },
            { "value": "spot-cleaning", "label": "Cleaning" }
          ],
          "default": "hero-kitchen"
        },
        { "type": "text", "id": "tag", "label": "Small label", "default": "Delivery in 2–3 days" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Your home essentials, one tap away." },
        { "type": "text", "id": "text", "label": "Text", "default": "Cash on delivery all over Lebanon. Free delivery over $50." },
        { "type": "text", "id": "button", "label": "Button", "default": "Shop now" },
        { "type": "url", "id": "link", "label": "Button link" }
      ]
    },
    {
      "type": "tile",
      "name": "Small photo tile",
      "limit": 2,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        {
          "type": "select",
          "id": "stock",
          "label": "Built-in photo (used when no photo is uploaded)",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "hero-rolls", "label": "Paper rolls" },
            { "value": "offer-care", "label": "Personal care" },
            { "value": "offer-home", "label": "Living room" },
            { "value": "spot-cleaning", "label": "Cleaning" },
            { "value": "hero-kitchen", "label": "Kitchen" },
            { "value": "hero-bottles", "label": "Bottles" }
          ],
          "default": "hero-rolls"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Stock up on tissues" },
        { "type": "text", "id": "text", "label": "Text", "default": "Up to 33% off" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yalla Haul promo banners",
      "blocks": [
        { "type": "slide" },
        { "type": "tile" },
        { "type": "tile", "settings": { "stock": "offer-care", "title": "Personal care", "text": "For the whole family" } }
      ]
    }
  ]
}
{% endschema %}

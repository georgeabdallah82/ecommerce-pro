{%- comment -%}
  A collection's products next to a big photo banner ("A cleaner home in one order"). On
  phones the banner sits on top and the products swipe sideways.
{%- endcomment -%}
{%- liquid
  assign c = section.settings.collection
  if c == blank or c.products_count == 0
    assign c = collections.all
  endif
  assign limit = section.settings.limit
-%}
<div class="yh-section">
  <div class="yh-wrap">
    <div class="yh-head">
      <h2>{{ section.settings.heading | default: c.title | escape }}</h2>
      {%- if section.settings.link_label != blank -%}
        <a href="{{ c.url | default: routes.all_products_collection_url }}" class="yh-link">{{ section.settings.link_label | escape }}</a>
      {%- endif -%}
    </div>
    <div class="yh-spot{% if section.settings.banner_side == 'right' %} yh-spot--right{% endif %}">
      <a href="{{ section.settings.banner_link | default: c.url | default: routes.all_products_collection_url }}" class="yh-spot__banner">
        {%- render 'yh-photo',
          image: section.settings.image,
          stock: section.settings.stock,
          widths: '400, 600, 900',
          sizes: '(min-width: 750px) 28vw, 100vw',
          class: 'yh-cover'
        -%}
        <span class="yh-spot__text">
          {%- if section.settings.tag != blank -%}<small>{{ section.settings.tag | escape }}</small>{%- endif -%}
          {%- if section.settings.title != blank -%}<b>{{ section.settings.title | escape }}</b>{%- endif -%}
          {%- if section.settings.button != blank -%}<span class="yh-btn yh-btn--white">{{ section.settings.button | escape }}</span>{%- endif -%}
        </span>
      </a>
      <div class="yh-spot__grid">
        {%- if c.products_count > 0 -%}
          {%- for product in c.products limit: limit -%}
            {%- render 'yh-card', card_product: product, section_id: section.id -%}
          {%- endfor -%}
        {%- else -%}
          {%- for i in (1..limit) -%}
            {%- render 'yh-card', card_product: blank, section_id: section.id -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Products with banner",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading (empty = collection name)" },
    { "type": "text", "id": "link_label", "label": "\"Shop all\" link", "default": "Shop all" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "header", "content": "Banner" },
    {
      "type": "select",
      "id": "banner_side",
      "label": "Banner side on computers",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    { "type": "image_picker", "id": "image", "label": "Photo" },
    {
      "type": "select",
      "id": "stock",
      "label": "Built-in photo (used when no photo is uploaded)",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "spot-cleaning", "label": "Cleaning" },
        { "value": "offer-home", "label": "Living room" },
        { "value": "offer-care", "label": "Personal care" },
        { "value": "hero-kitchen", "label": "Kitchen" },
        { "value": "hero-rolls", "label": "Paper rolls" },
        { "value": "hero-bottles", "label": "Bottles" }
      ],
      "default": "spot-cleaning"
    },
    { "type": "text", "id": "tag", "label": "Tag", "default": "Featured" },
    { "type": "text", "id": "title", "label": "Title", "default": "A cleaner home in one order" },
    { "type": "text", "id": "button", "label": "Button", "default": "Shop now" },
    { "type": "url", "id": "banner_link", "label": "Banner link (empty = the collection)" }
  ],
  "presets": [{ "name": "Products with banner" }]
}
{% endschema %}

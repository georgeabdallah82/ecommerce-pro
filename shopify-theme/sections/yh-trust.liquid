{%- comment -%}
  Reasons to buy, as four soft cards with an icon each.
{%- endcomment -%}
<div class="yh-section">
  <div class="yh-wrap">
    <div class="yh-trust">
      {%- for block in section.blocks -%}
        <div class="yh-trust__item" {{ block.shopify_attributes }}>
          <span class="yh-trust__icon">{%- render 'yh-icon', icon: block.settings.icon, size: 21 -%}</span>
          <span class="yh-trust__text">
            <b>{{ block.settings.title | escape }}</b>
            {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul trust cards",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Delivery truck" },
            { "value": "cash", "label": "Cash" },
            { "value": "return", "label": "Return arrow" },
            { "value": "lock", "label": "Lock" },
            { "value": "chat", "label": "Chat" },
            { "value": "package", "label": "Box" },
            { "value": "check", "label": "Check mark" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "2–3 day delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "All over Lebanon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yalla Haul trust cards",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "icon": "cash", "title": "Cash on delivery", "text": "Pay at your door" } },
        { "type": "item", "settings": { "icon": "return", "title": "Easy returns", "text": "Changed your mind?" } },
        { "type": "item", "settings": { "icon": "lock", "title": "Secure checkout", "text": "Powered by Shopify" } }
      ]
    }
  ]
}
{% endschema %}

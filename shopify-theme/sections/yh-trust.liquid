{%- comment -%}
  Reasons to buy (cash on delivery, delivery all over Lebanon...), on a white strip.
{%- endcomment -%}
<div class="yh-section yh-trust-sec">
  <div class="yh-wrap">
    <div class="yh-trust">
      {%- for block in section.blocks -%}
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="yh-trust__item" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="yh-trust__item" {{ block.shopify_attributes }}>
        {%- endif -%}
          <strong>{{ block.settings.title | escape }}</strong>
          {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
        {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Yalla Haul trust strip",
  "tag": "section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Cash on delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Pay when your order arrives" },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Yalla Haul trust strip",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "title": "Delivery all over Lebanon", "text": "Fast and tracked" } },
        { "type": "item", "settings": { "title": "Easy returns", "text": "See our refund policy" } },
        { "type": "item", "settings": { "title": "WhatsApp support", "text": "Questions? Message us" } }
      ]
    }
  ]
}
{% endschema %}

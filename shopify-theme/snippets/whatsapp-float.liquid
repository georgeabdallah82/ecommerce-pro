{%- comment -%} Floating WhatsApp button (theme settings > WhatsApp). {%- endcomment -%}
{%- if settings.whatsapp_enabled and settings.whatsapp_number != blank -%}
  <a class="mkWhatsApp mkWhatsApp--{{ settings.whatsapp_position }}{% unless settings.whatsapp_show_on_mobile %} mkWhatsApp--desktop-only{% endunless %}"
     href="https://wa.me/{{ settings.whatsapp_number | replace: ' ', '' | replace: '+', '' }}?text={{ settings.whatsapp_message | url_encode }}"
     target="_blank" rel="noopener"
     aria-label="{{ 'whatsapp.label' | t }}">
    <span class="mkWhatsAppLabel">{{ 'whatsapp.label' | t }}</span>
  </a>
{%- endif -%}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommerce-pro",
  "main": "worker.ts",
  "preview_urls": false,
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "ecommerce-pro-media" }
  ],
  // The live chat relay (lib/live-chat/hub.ts, exported from worker.ts): one Durable Object that passes
  // messages between shoppers and staff and keeps the "I'm online" switch. SQLite-backed, so it is
  // available on the Workers Free plan.
  "durable_objects": {
    "bindings": [{ "name": "LIVE_CHAT", "class_name": "LiveChatHub" }]
  },
  "migrations": [
    { "tag": "live-chat-v1", "new_sqlite_classes": ["LiveChatHub"] }
  ],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Once a day at 05:37 UTC (08:37 in Beirut): the owner's morning summary and the review-request
  // emails (worker.ts scheduled() -> /api/internal/daily). Right before the 05:41 database-hours
  // check, so both use the same database wake-up.
  // Every 15 minutes: the order watch (lib/order-watch.ts). It reads a small marker file first and
  // only asks the database when an order is being watched, so it costs no database hours otherwise.
  // The refund reconciliation runs on this cron too, but only at the top of the hour (worker.ts, reconcileDue).
  "triggers": {
    "crons": ["37 5 * * *", "*/15 * * * *"]
  },
  "vars": {
    "EMAIL_FROM": "Yalla Haul <orders@yallahaul.com>"
  }
}

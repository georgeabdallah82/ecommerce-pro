{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecommerce-pro",
  "main": "worker.ts",
  "preview_urls": false,
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "MEDIA_BUCKET", "bucket_name": "ecommerce-pro-media" }
  ],
  "observability": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Once a day at 05:37 UTC (08:37 in Beirut): the owner's morning summary and the review-request
  // emails (worker.ts scheduled() -> /api/internal/daily). Right before the 05:41 database-hours
  // check, so both use the same database wake-up.
  "triggers": {
    "crons": ["37 5 * * *"]
  },
  "vars": {
    "EMAIL_FROM": "Yalla Haul <orders@yallahaul.com>"
  }
}
